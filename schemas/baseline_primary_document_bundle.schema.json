{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "baseline_primary_document_bundle.schema.json",
  "title": "Baseline primary-document bundle",
  "description": "The governed input contract the Stage 00C packet builder consumes (W2-C-beta, ADR-091). A bundle is a local directory of primary annual-report documents plus this manifest. Every entry carries its own per-document selection provenance \u2014 the filing-index response hash, the selected document, and the primary URL that produced these bytes \u2014 because route validation is not selection evidence: route_validation records only that a filing-index probe proved the URL grammar for its own accessions. Documents are hash-verified before parsing and the run refuses on any mismatch. Domestic 10-K/10-KT only; the FPI extension cohort is preserved by the frame and carrier and is neither handled nor excluded here. A later acquisition increment emits this contract; nothing in the packet builder fetches it. local_filename and selected_document are distinct fields and are never required to be equal: the document SEC selected and the file this bundle stores it as are separate facts. Both must be safe leaf filenames \u2014 no absolute path, separator, dot segment or traversal \u2014 and are validated before any file is opened. Each document's declared source_byte_length and source_sha256 are both verified against the bytes on disk, and a declared value is never replaced by an observed one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_contract",
    "description",
    "provenance",
    "route_validation",
    "documents"
  ],
  "properties": {
    "bundle_contract": {
      "const": "baseline_primary_document_bundle@0.1.0"
    },
    "description": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier_run_id",
        "carrier_manifest_sha256",
        "freeze_record_sha256"
      ],
      "properties": {
        "carrier_run_id": {
          "type": "string"
        },
        "carrier_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "freeze_record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "acquisition_run_id": {
          "type": "string"
        },
        "acquisition_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "route_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_run_id",
        "probe_manifest_sha256",
        "covered_accessions",
        "note"
      ],
      "properties": {
        "probe_run_id": {
          "type": "string"
        },
        "probe_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "covered_accessions": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cik",
          "accession",
          "form",
          "stratum",
          "baseline_filing_date",
          "local_filename",
          "source_sha256",
          "source_byte_length",
          "filing_index_url",
          "filing_index_response_sha256",
          "selected_document",
          "primary_url"
        ],
        "properties": {
          "cik": {
            "type": "string",
            "pattern": "^\\d{10}$"
          },
          "accession": {
            "type": "string",
            "pattern": "^\\d{10}-\\d{2}-\\d{6}$"
          },
          "form": {
            "enum": [
              "10-K",
              "10-KT"
            ]
          },
          "stratum": {
            "const": "domestic"
          },
          "baseline_filing_date": {
            "type": "string",
            "format": "date"
          },
          "local_filename": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/\\\\:~][^/\\\\:]*$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_byte_length": {
            "type": "integer",
            "minimum": 1
          },
          "filing_index_url": {
            "type": "string"
          },
          "filing_index_response_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "selected_document": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/\\\\:~][^/\\\\:]*\\.(?i:htm|html)$"
          },
          "primary_url": {
            "type": "string"
          }
        }
      }
    }
  }
}
