{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamic-ai-products/schemas/universe_classifier_record.v2.schema.json",
  "title": "Universe classifier record v0.2.0",
  "description": "ADR-128. Successor to universe_classifier_record@0.1.0, identical except that it inlines the 0.2.0 axes contract. The record schema embeds the axes contract rather than referencing it, so a wider axes bound would otherwise still be refused at this layer. ADR-126. One stored classifier row: the validated model axes, the tier a versioned deterministic engine derived from them, the full rule trace, the provenance of the model output, and the admission provenance explaining why the firm was in the cohort at all. Deliberately minimal: adjudication, review state and downstream sampling decisions live outside this record, so a later review cannot be mistaken for what the classifier observed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_contract",
    "record_kind",
    "cik",
    "accession",
    "company_id",
    "form",
    "baseline_filing_date",
    "source_id",
    "packet_sha256",
    "prompt_sha256",
    "model_route",
    "admission_provenance",
    "output_provenance",
    "axes",
    "tier",
    "tier_rule_trace",
    "failure_reason_code",
    "failure_detail",
    "provider_attempt_telemetry",
    "truncation_evidence"
  ],
  "properties": {
    "record_contract": {
      "const": "universe_classifier_record@0.2.0"
    },
    "record_kind": {
      "enum": [
        "classified",
        "model_output_unusable",
        "provider_unresolved",
        "model_output_truncated"
      ]
    },
    "cik": {
      "type": "string",
      "pattern": "^[0-9]{10}$"
    },
    "accession": {
      "type": "string",
      "minLength": 1
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "form": {
      "type": "string",
      "minLength": 1
    },
    "baseline_filing_date": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_route": {
      "type": [
        "object",
        "null"
      ]
    },
    "admission_provenance": {
      "description": "Why this firm was admitted. Non-authoritative for the classification: the axes are judged against the complete Item 1 packet, not against this context.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_id",
        "admission_origin",
        "admitted_status",
        "non_authoritative",
        "model_screen",
        "human_review"
      ],
      "properties": {
        "cohort_id": {
          "type": "string",
          "minLength": 1
        },
        "admission_origin": {
          "enum": [
            "model_screen",
            "human_review"
          ]
        },
        "admitted_status": {
          "enum": [
            "LIKELY_ELIGIBLE",
            "BOUNDARY_OR_UNCERTAIN"
          ]
        },
        "non_authoritative": {
          "const": true
        },
        "model_screen": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "release_id",
                "release_origin",
                "raw_response_id",
                "raw_response_sha256"
              ],
              "properties": {
                "release_id": {
                  "type": "string",
                  "minLength": 1
                },
                "release_origin": {
                  "description": "Which SCREEN_v1 release origin produced the named response, so a reader can tell a first-pass screen from a repaired one without reopening the release.",
                  "enum": [
                    "base_valid",
                    "repaired"
                  ]
                },
                "raw_response_id": {
                  "type": "string",
                  "minLength": 1
                },
                "raw_response_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "human_review": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "overlay_id",
                "reviewer_id",
                "review_protocol_version",
                "decision_timestamp",
                "evidence_items"
              ],
              "properties": {
                "overlay_id": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewer_id": {
                  "type": "string",
                  "minLength": 1
                },
                "review_protocol_version": {
                  "type": "string",
                  "minLength": 1
                },
                "decision_timestamp": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        }
      }
    },
    "output_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "origin",
        "raw_response_id",
        "raw_response_sha256",
        "source_run_id",
        "source_raw_responses_sha256",
        "source_receipt_sha256"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_response_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "raw_response_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "origin": {
          "enum": [
            "model_called",
            "reused_source_prefix"
          ]
        },
        "source_run_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_raw_responses_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_receipt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "description": "Where this row's model output came from. A row a continuation reused names the failed run it was archived in; a row this run called names nothing."
    },
    "axes": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://dynamic-ai-products/schemas/universe_classifier_axes_record.v2.schema.json",
          "title": "Universe classifier axes record v0.2.0",
          "description": "ADR-128. Successor to universe_classifier_axes_record@0.1.0. The economic axes vocabulary is unchanged in every value: the only change is that two output ceilings were too tight for the corpus. Three of three calibration responses were valid JSON with valid axes and were refused solely for evidence count and quote length, one legitimate verbatim Item 1 span running 972 characters against a 300-character cap, and the six-value axis enum leaving no headroom under a six-item evidence cap. The 0.1.0 contract stays byte-identical so the failed run's evidence remains interpretable under the contract it ran under. ADR-126. Exactly what the model returns for one firm: economic axes and the evidence for them. There is deliberately no tier field of any name. A tier is derived afterwards by a versioned deterministic engine from these axes, so a prompt revision can never silently move tier membership, and a model that emits a tier is refused rather than obeyed. Every array and string is bounded, because the run is held to the committed max-output-token contract and compactness is a contract term, not a preference.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "customer_value_archetypes",
            "software_centrality",
            "complementary_dependencies",
            "firm_structure",
            "commercial_materiality",
            "customer_facing_functional_product",
            "economically_eligible",
            "data_eligible",
            "customer_market_orientation",
            "boundary_flags",
            "contradictions",
            "evidence",
            "confidence"
          ],
          "properties": {
            "customer_value_archetypes": {
              "type": "array",
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "FUNCTIONAL_SOFTWARE",
                  "ADAPTIVE_DIGITAL_SERVICE",
                  "DATA_ANALYTICS_PRODUCT",
                  "TRANSACTION_INFRASTRUCTURE",
                  "MARKETPLACE_COORDINATION",
                  "CONTENT_CATALOG",
                  "ATTENTION_SOCIAL_PLATFORM",
                  "INTERACTIVE_ENTERTAINMENT",
                  "HARDWARE_SOFTWARE_SYSTEM",
                  "HUMAN_MANAGED_SERVICE",
                  "ECOMMERCE_RETAIL",
                  "PHYSICAL_SERVICE_NETWORK",
                  "OTHER"
                ]
              }
            },
            "software_centrality": {
              "enum": [
                "CORE",
                "CO_ESSENTIAL",
                "ENABLING",
                "PERIPHERAL",
                "UNKNOWN"
              ]
            },
            "complementary_dependencies": {
              "type": "array",
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "NONE_OR_STANDARD_COMPUTE",
                  "CUSTOMER_DATA",
                  "FIRM_PROPRIETARY_DATA",
                  "LICENSED_DATA",
                  "LICENSED_CONTENT",
                  "NETWORK_OR_INSTALLED_BASE",
                  "REGULATED_TRANSACTION_RAIL",
                  "EXECUTION_PERMISSIONS",
                  "HARDWARE_OR_DEVICE",
                  "PHYSICAL_SUPPLY_NETWORK",
                  "LIVE_HUMAN_LABOR",
                  "SPECIALIZED_NON_LLM_ENGINE",
                  "OTHER"
                ]
              }
            },
            "firm_structure": {
              "enum": [
                "PURE_PLAY",
                "SOFTWARE_DOMINANT",
                "MIXED_SEPARABLE",
                "MIXED_NONSEPARABLE",
                "SOFTWARE_PERIPHERAL",
                "UNKNOWN"
              ]
            },
            "commercial_materiality": {
              "enum": [
                "DOMINANT",
                "MATERIAL",
                "MINOR",
                "UNKNOWN"
              ]
            },
            "customer_facing_functional_product": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "economically_eligible": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "data_eligible": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "customer_market_orientation": {
              "description": "Descriptive metadata only. The deterministic tier engine takes this as no input at all.",
              "enum": [
                "B2B",
                "B2C",
                "MIXED",
                "UNKNOWN"
              ]
            },
            "boundary_flags": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "contradictions": {
              "description": "Where the complete Item 1 packet qualifies or contradicts the non-authoritative admission context.",
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "evidence": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "axis",
                  "passage_ref",
                  "quote",
                  "supported_claim"
                ],
                "properties": {
                  "axis": {
                    "enum": [
                      "customer_value",
                      "centrality",
                      "dependency",
                      "structure",
                      "materiality",
                      "eligibility"
                    ]
                  },
                  "passage_ref": {
                    "type": "string",
                    "pattern": "^P[0-9]{3}$"
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1200
                  },
                  "supported_claim": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              }
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            }
          }
        }
      ]
    },
    "tier": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "TIER_A",
            "TIER_B",
            "TIER_C",
            "EXCLUDED",
            "UNCERTAIN"
          ]
        }
      ]
    },
    "tier_rule_trace": {
      "description": "The complete ordered trace the deterministic engine produced. Replayable: the same axes and the same pinned rule config always yield this trace.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tier_rules_version",
            "tier_rules_sha256",
            "entries"
          ],
          "properties": {
            "tier_rules_version": {
              "type": "string",
              "minLength": 1
            },
            "tier_rules_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "entries": {
              "type": "array",
              "minItems": 1,
              "maxItems": 24,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rule_id",
                  "result"
                ],
                "properties": {
                  "rule_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  },
                  "detail": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "failure_reason_code": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "failure_detail": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_attempt_telemetry": {
      "type": [
        "object",
        "null"
      ]
    },
    "truncation_evidence": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "classified"
          }
        },
        "required": [
          "record_kind"
        ]
      },
      "then": {
        "properties": {
          "axes": {
            "type": "object"
          },
          "tier": {
            "enum": [
              "TIER_A",
              "TIER_B",
              "TIER_C",
              "EXCLUDED",
              "UNCERTAIN"
            ]
          },
          "tier_rule_trace": {
            "type": "object"
          },
          "failure_reason_code": {
            "type": "null"
          },
          "truncation_evidence": {
            "type": "null"
          },
          "provider_attempt_telemetry": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "model_output_unusable"
          }
        },
        "required": [
          "record_kind"
        ]
      },
      "then": {
        "properties": {
          "axes": {
            "type": "null"
          },
          "tier": {
            "type": "null"
          },
          "tier_rule_trace": {
            "type": "null"
          },
          "failure_reason_code": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "provider_unresolved"
          }
        },
        "required": [
          "record_kind"
        ]
      },
      "then": {
        "properties": {
          "axes": {
            "type": "null"
          },
          "tier": {
            "type": "null"
          },
          "tier_rule_trace": {
            "type": "null"
          },
          "provider_attempt_telemetry": {
            "type": "object"
          },
          "failure_reason_code": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "model_output_truncated"
          }
        },
        "required": [
          "record_kind"
        ]
      },
      "then": {
        "properties": {
          "axes": {
            "type": "null"
          },
          "tier": {
            "type": "null"
          },
          "tier_rule_trace": {
            "type": "null"
          },
          "truncation_evidence": {
            "type": "object"
          },
          "failure_reason_code": {
            "const": "max_tokens"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admission_provenance": {
            "properties": {
              "admission_origin": {
                "const": "model_screen"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "admission_provenance": {
            "properties": {
              "model_screen": {
                "type": "object"
              },
              "human_review": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admission_provenance": {
            "properties": {
              "admission_origin": {
                "const": "human_review"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "admission_provenance": {
            "properties": {
              "model_screen": {
                "type": "null"
              },
              "human_review": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "output_provenance": {
            "properties": {
              "origin": {
                "const": "reused_source_prefix"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "output_provenance": {
            "required": [
              "source_run_id",
              "source_raw_responses_sha256",
              "source_receipt_sha256"
            ],
            "properties": {
              "source_run_id": {
                "type": "string"
              },
              "source_raw_responses_sha256": {
                "type": "string"
              },
              "source_receipt_sha256": {
                "type": "string"
              },
              "raw_response_id": {
                "type": "string"
              },
              "raw_response_sha256": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "output_provenance": {
            "properties": {
              "origin": {
                "const": "model_called"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "output_provenance": {
            "properties": {
              "source_run_id": {
                "type": "null"
              },
              "source_raw_responses_sha256": {
                "type": "null"
              },
              "source_receipt_sha256": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
