{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamic-ai-products/schemas/universe_screen_repair_authorization.schema.json",
  "title": "Universe screen repair authorization v0.1.0",
  "description": "ADR-123 Stage 2. A fourth authorization contract: the authoritative live grant, the 100-row diagnostic grant, the seven-row diagnostic-repair grant and the continuation grants each pin their own contract const, so no runner can consume another's. This grant binds the repair prompt explicitly and is refused by every other route. A repair run is a measurement: promotable is false and the outputs carry repair-only names.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_contract",
    "authorization_id",
    "authorized_by",
    "budget_max_estimated_cost_micros",
    "budget_max_external_requests",
    "budget_max_input_tokens",
    "budget_max_output_tokens",
    "budget_max_wall_clock_seconds",
    "count_attempt_cap",
    "count_attempts_per_row",
    "deployment_environment_id",
    "effective_at",
    "endpoint_allowlist",
    "expires_at",
    "external_requests_per_row",
    "generate_attempts_per_row",
    "logical_row_cap",
    "max_repair_unverified",
    "model_route",
    "output_contract",
    "packet_manifest_sha256",
    "promotable",
    "prompt_template_path",
    "prompt_template_sha256",
    "provider_attempt_cap",
    "provider_client_contract_reference",
    "provider_client_contract_sha256",
    "rate_limit_policy_version",
    "retry_policy_version",
    "rollout_state",
    "run_kind",
    "screen_adapter_enablement_reference",
    "screen_adapter_enablement_sha256",
    "screen_count_retry_policy_version",
    "screen_generate_retry_policy_version",
    "screen_stage",
    "selection_artifact_sha256",
    "selection_kind",
    "source_run_id",
    "vertex_location",
    "vertex_project"
  ],
  "properties": {
    "authorization_contract": {
      "const": "universe_screen_repair_authorization@0.1.0"
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "authorized_by": {
      "type": "string",
      "minLength": 1
    },
    "budget_max_estimated_cost_micros": {
      "type": "integer",
      "minimum": 1
    },
    "budget_max_external_requests": {
      "type": "integer",
      "minimum": 1
    },
    "budget_max_input_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "budget_max_output_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "budget_max_wall_clock_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "count_attempt_cap": {
      "type": "integer",
      "minimum": 1
    },
    "count_attempts_per_row": {
      "const": 3
    },
    "deployment_environment_id": {
      "type": "string",
      "minLength": 1
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "endpoint_allowlist": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "external_requests_per_row": {
      "const": 8
    },
    "generate_attempts_per_row": {
      "const": 5
    },
    "logical_row_cap": {
      "type": "integer",
      "minimum": 1
    },
    "max_repair_unverified": {
      "description": "The bounded tolerance for rows that fail validation again. A repair run measures a rate; it may not be unbounded, and the run stops fail-closed above it.",
      "type": "integer",
      "minimum": 1
    },
    "model_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_label"
      ],
      "properties": {
        "provider": {
          "const": "google_vertex_ai"
        },
        "model_label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output_contract": {
      "const": "universe_screen_record@0.6.0"
    },
    "packet_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "promotable": {
      "const": false
    },
    "prompt_template_path": {
      "const": "prompts/discovery/universe_high_recall_screen_repair.v1.md"
    },
    "prompt_template_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_attempt_cap": {
      "type": "integer",
      "minimum": 1
    },
    "provider_client_contract_reference": {
      "type": "string",
      "minLength": 1
    },
    "provider_client_contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rate_limit_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "retry_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "rollout_state": {
      "type": "string",
      "minLength": 1
    },
    "run_kind": {
      "const": "unverified_repair"
    },
    "screen_adapter_enablement_reference": {
      "type": "string",
      "minLength": 1
    },
    "screen_adapter_enablement_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "screen_count_retry_policy_version": {
      "const": "universe_screen_count_retry_policy_v1"
    },
    "screen_generate_retry_policy_version": {
      "const": "universe_screen_generate_retry_policy_v1"
    },
    "screen_stage": {
      "const": "universe_high_recall_screen"
    },
    "selection_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selection_kind": {
      "const": "unverified_repair"
    },
    "source_run_id": {
      "type": "string",
      "minLength": 1
    },
    "vertex_location": {
      "type": "string",
      "minLength": 1
    },
    "vertex_project": {
      "type": "string",
      "minLength": 1
    }
  }
}
