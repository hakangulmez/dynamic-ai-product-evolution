{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extraction_input_packet.schema.json",
  "title": "Extraction input packet",
  "description": "The bounded, hash-bound provider input for one extraction stage (ADR-033). Stage-scoped: the product stage forbids parent context; the capability stage carries Snapshot A and product-validation provenance; the task stage carries Snapshot B and both validation provenances. Parent ids are derived only from re-read, hash-verified snapshot members, never caller-supplied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "stage",
    "company_id",
    "observation_cutoff_date",
    "corpus_scope",
    "coverage_artifact",
    "source_snapshot_manifest",
    "passages",
    "filter_ledger",
    "parent_context",
    "product_validation_provenance",
    "capability_validation_provenance"
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_pin": {
      "type": "object",
      "required": ["reference", "sha256"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "snapshot_version": { "type": "string", "minLength": 1 }
      }
    },
    "parent_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "reference", "sha256", "payload"],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "payload": { "type": "object" }
      }
    },
    "drop_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passage_id", "reason"],
      "properties": {
        "passage_id": { "type": ["string", "null"] },
        "reason": { "enum": ["blank_text", "temporally_invalid"] }
      }
    },
    "validation_provenance": {
      "type": ["object", "null"],
      "required": ["reference", "sha256"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "raw_artifact_sha256": { "type": ["string", "null"] },
        "candidate_collection_sha256": { "type": ["string", "null"] }
      }
    }
  },
  "properties": {
    "contract": { "const": "extraction_input_packet@0.1.0" },
    "schema_version": { "const": "0.1.0" },
    "stage": {
      "enum": ["product_extraction", "capability_extraction", "task_extraction"]
    },
    "company_id": { "type": "string", "pattern": "^CIK[0-9]{10}$" },
    "observation_cutoff_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "corpus_scope": {
      "comment": "One of exactly two scope carriers (ADR-033). The other is the pinned source_family_coverage artifact. No third scope artifact exists.",
      "enum": ["sec_only_partial"]
    },
    "coverage_artifact": { "$ref": "#/$defs/artifact_pin" },
    "source_snapshot_manifest": { "$ref": "#/$defs/artifact_pin" },
    "passages": {
      "type": "array",
      "comment": "Admissible passages only: non-blank text and publication_date <= observation_cutoff_date. There is no length threshold; a one-character non-blank passage is admissible.",
      "items": { "type": "object" }
    },
    "filter_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_passage_count",
        "blank_drop_count",
        "temporal_drop_count",
        "surviving_count",
        "blank_drops",
        "temporal_drops"
      ],
      "properties": {
        "input_passage_count": { "type": "integer", "minimum": 0 },
        "blank_drop_count": { "type": "integer", "minimum": 0 },
        "temporal_drop_count": { "type": "integer", "minimum": 0 },
        "surviving_count": { "type": "integer", "minimum": 0 },
        "blank_drops": { "type": "array", "items": { "$ref": "#/$defs/drop_entry" } },
        "temporal_drops": { "type": "array", "items": { "$ref": "#/$defs/drop_entry" } }
      }
    },
    "parent_context": {
      "type": ["object", "null"],
      "required": ["snapshot", "product_parents"],
      "properties": {
        "snapshot": { "$ref": "#/$defs/artifact_pin" },
        "product_parents": {
          "type": "array",
          "items": { "$ref": "#/$defs/parent_entry" }
        },
        "capability_parents": {
          "type": "array",
          "comment": "A legal Snapshot B may carry zero accepted capability parents, so an empty array is valid and role presence can never discriminate A from B.",
          "items": { "$ref": "#/$defs/parent_entry" }
        }
      }
    },
    "product_validation_provenance": { "$ref": "#/$defs/validation_provenance" },
    "capability_validation_provenance": { "$ref": "#/$defs/validation_provenance" }
  },
  "allOf": [
    {
      "comment": "The product stage forbids parent context and all validation provenance.",
      "if": { "properties": { "stage": { "const": "product_extraction" } } },
      "then": {
        "properties": {
          "parent_context": { "type": "null" },
          "product_validation_provenance": { "type": "null" },
          "capability_validation_provenance": { "type": "null" }
        }
      }
    },
    {
      "comment": "The capability stage requires Snapshot A context and product-validation provenance, and forbids capability-validation provenance.",
      "if": { "properties": { "stage": { "const": "capability_extraction" } } },
      "then": {
        "properties": {
          "parent_context": { "type": "object" },
          "product_validation_provenance": { "type": "object" },
          "capability_validation_provenance": { "type": "null" }
        }
      }
    },
    {
      "comment": "The task stage requires Snapshot B context and both validation provenances.",
      "if": { "properties": { "stage": { "const": "task_extraction" } } },
      "then": {
        "properties": {
          "parent_context": {
            "type": "object",
            "required": ["snapshot", "product_parents", "capability_parents"]
          },
          "product_validation_provenance": { "type": "object" },
          "capability_validation_provenance": { "type": "object" }
        }
      }
    }
  ]
}
