{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dera_fsds_acquisition_manifest.schema.json",
  "title": "DERA FSDS acquisition manifest (v0.1, fixture replay)",
  "description": "Immutable manifest of one fixture-replay DERA FSDS archive acquisition (ADR-082). Raw release ZIPs are preserved write-once with receipts and exactly one sub.txt member per archive is extracted under the code-owned uncompressed ceiling. observed_through and its evidence basis are plan-authored, never inferred. DERA is an independent FRAME validation source only. The sec_live successor contract is dera_fsds_acquisition_manifest.v2, never a widened fixture contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "request_plan_sha256",
    "url_template",
    "observed_through",
    "observed_through_basis",
    "transport_kind",
    "transport_contract_hash",
    "max_sub_uncompressed_bytes",
    "archives",
    "counts",
    "output_hashes",
    "run_timestamp",
    "schema_versions",
    "limitations"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "request_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "url_template": {
      "type": "string",
      "pattern": "^https://www\\.sec\\.gov/\\S+$"
    },
    "observed_through": {
      "type": "string",
      "format": "date"
    },
    "observed_through_basis": {
      "type": "string",
      "minLength": 1
    },
    "transport_kind": {
      "enum": [
        "fixture_replay"
      ]
    },
    "transport_contract_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "max_sub_uncompressed_bytes": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "archives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "release",
          "url",
          "zip_filename",
          "zip_sha256",
          "zip_byte_count",
          "status_code",
          "retrieved_at",
          "member_name",
          "member_sha256",
          "sub_filename",
          "sub_sha256",
          "sub_byte_count"
        ],
        "properties": {
          "release": {
            "type": "string",
            "pattern": "^\\d{4}q[1-4]$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://www\\.sec\\.gov/\\S+$"
          },
          "zip_filename": {
            "type": "string",
            "pattern": "^dera-\\d{4}q[1-4]\\.zip$"
          },
          "zip_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "zip_byte_count": {
            "type": "integer",
            "minimum": 0
          },
          "status_code": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "member_name": {
            "const": "sub.txt"
          },
          "member_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sub_filename": {
            "type": "string",
            "pattern": "^dera-\\d{4}q[1-4]-sub\\.tsv$"
          },
          "sub_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sub_byte_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "output_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "run_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "schema_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
