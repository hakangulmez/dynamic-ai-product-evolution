{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pct_item1_combined_snapshot_output.v1.schema.json",
  "title": "PCT Item 1 combined snapshot model output v1",
  "description": "Development-only model-facing output for one Item 1 product-capability-task snapshot. It addresses evidence through the packet's existing displayed P001-style references; evidence text, offsets, hashes, scores, and later measurement labels are pipeline concerns and are forbidden here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["products", "capabilities", "tasks"],
  "properties": {
    "products": {
      "type": "array",
      "items": { "$ref": "#/$defs/product" }
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "availability_status": {
      "type": "string",
      "enum": [
        "announced",
        "private_beta",
        "public_beta",
        "general_availability",
        "broadly_deployed_or_default",
        "deprecated",
        "discontinued",
        "unknown"
      ]
    },
    "passage_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^P[0-9]{3}$" }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "product_family", "availability_status", "passage_refs"],
      "properties": {
        "id": { "type": "string", "pattern": "^P[1-9][0-9]*$" },
        "name": { "type": "string", "minLength": 1 },
        "product_family": { "type": ["string", "null"] },
        "availability_status": { "$ref": "#/$defs/availability_status" },
        "passage_refs": { "$ref": "#/$defs/passage_refs" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "product_id", "text", "availability_status", "passage_refs"],
      "properties": {
        "id": { "type": "string", "pattern": "^C[1-9][0-9]*$" },
        "product_id": { "type": "string", "pattern": "^P[1-9][0-9]*$" },
        "text": { "type": "string", "minLength": 1 },
        "availability_status": { "$ref": "#/$defs/availability_status" },
        "passage_refs": { "$ref": "#/$defs/passage_refs" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "product_id", "capability_ids", "text", "customer_need", "availability_status", "passage_refs"],
      "properties": {
        "id": { "type": "string", "pattern": "^T[1-9][0-9]*$" },
        "product_id": { "type": "string", "pattern": "^P[1-9][0-9]*$" },
        "capability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^C[1-9][0-9]*$" }
        },
        "text": { "type": "string", "minLength": 1 },
        "customer_need": { "type": "string", "minLength": 1 },
        "availability_status": { "$ref": "#/$defs/availability_status" },
        "passage_refs": { "$ref": "#/$defs/passage_refs" }
      }
    }
  }
}
