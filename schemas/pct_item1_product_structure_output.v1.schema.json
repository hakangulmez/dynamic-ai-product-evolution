{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pct_item1_product_structure_output.v1.schema.json",
  "title": "PCT Item 1 product structure model output v1",
  "description": "Development-only product-family and product map for one complete Item 1 packet. Evidence text, offsets, hashes, capabilities, tasks, and later measurement fields are pipeline or later-stage concerns.",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_families", "products"],
  "properties": {
    "product_families": {"type": "array", "items": {"$ref": "#/$defs/product_family"}},
    "products": {"type": "array", "items": {"$ref": "#/$defs/product"}}
  },
  "$defs": {
    "passage_refs": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^P[0-9]{3}$"}},
    "product_family": {"type": "object", "additionalProperties": false, "required": ["id", "name", "passage_refs"], "properties": {"id": {"type": "string", "pattern": "^F[1-9][0-9]*$"}, "name": {"type": "string", "minLength": 1}, "passage_refs": {"$ref": "#/$defs/passage_refs"}}},
    "product": {"type": "object", "additionalProperties": false, "required": ["id", "name", "product_family_id", "availability_status", "passage_refs"], "properties": {"id": {"type": "string", "pattern": "^P[1-9][0-9]*$"}, "name": {"type": "string", "minLength": 1}, "product_family_id": {"type": ["string", "null"], "pattern": "^F[1-9][0-9]*$"}, "availability_status": {"type": "string", "enum": ["announced", "private_beta", "public_beta", "general_availability", "broadly_deployed_or_default", "deprecated", "discontinued", "unknown"]}, "passage_refs": {"$ref": "#/$defs/passage_refs"}}}
  }
}
