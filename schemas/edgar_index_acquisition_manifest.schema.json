{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edgar_index_acquisition_manifest.schema.json",
  "title": "EDGAR full-index acquisition manifest",
  "description": "Authoritative record of one acquisition run of EDGAR full-index master.idx files (SPEC-001 Stage A input; SPEC-003 provenance rules). Presence of this manifest is the sole mark of a successful, authoritative acquisition: a failed run persists only a non-authoritative failure receipt. transport_kind records how the bytes were actually obtained; fixture_replay is the only transport that exists before the post-W0 live-binding increment, and a live SEC transport contract will extend this schema in a successor version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "request_plan_sha256",
    "transport_kind",
    "transport_contract_hash",
    "files",
    "counts",
    "run_timestamp",
    "schema_versions",
    "limitations"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "request_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transport_kind": {
      "enum": [
        "fixture_replay"
      ]
    },
    "transport_contract_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quarter",
          "url",
          "filename",
          "sha256",
          "byte_count",
          "status_code",
          "retrieved_at"
        ],
        "properties": {
          "quarter": {
            "type": "string",
            "pattern": "^\\d{4}-QTR[1-4]$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://www\\.sec\\.gov/Archives/edgar/full-index/\\d{4}/QTR[1-4]/master\\.idx$"
          },
          "filename": {
            "type": "string",
            "pattern": "^master-\\d{4}-QTR[1-4]\\.idx$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0
          },
          "status_code": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "run_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "schema_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
