{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "capability_observation.schema.json",
  "required": [
    "capability_observation_id",
    "product_observation_id",
    "capability",
    "availability_status",
    "evidence",
    "confidence"
  ],
  "properties": {
    "capability_observation_id": {
      "type": "string"
    },
    "stable_capability_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "product_observation_id": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "normalized_capability": {
      "type": "string"
    },
    "input_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "availability_status": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "passage_id",
          "quote"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "passage_id": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        }
      }
    },
    "ambiguity": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "schema_version": {
      "type": "string"
    }
  }
}
