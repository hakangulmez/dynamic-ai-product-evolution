{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pct_item1_task_consolidation_output.v1.schema.json",
  "title": "PCT Item 1 task-consolidation model output v1",
  "description": "Development-only consolidation over fixed high-recall customer task candidates. The model does not author evidence references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["final_tasks", "excluded_task_candidates", "unresolved_task_ids"],
  "properties": {
    "final_tasks": {"type": "array", "items": {"$ref": "#/$defs/final_task"}},
    "excluded_task_candidates": {"type": "array", "items": {"$ref": "#/$defs/excluded"}},
    "unresolved_task_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^T[1-9][0-9]*$"}}
  },
  "$defs": {
    "final_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "economic_product_id", "source_task_ids", "capability_refs", "text"],
      "properties": {
        "id": {"type": "string", "pattern": "^FT[1-9][0-9]*$"},
        "economic_product_id": {"type": "string", "pattern": "^EP[1-9][0-9]*$"},
        "source_task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^T[1-9][0-9]*$"}},
        "capability_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EP[1-9][0-9]*:C[1-9][0-9]*$"}},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "reason"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^T[1-9][0-9]*$"},
        "reason": {"type": "string", "enum": ["capability_restatement", "generic_benefit_or_outcome", "internal_firm_activity", "commercial_mechanism", "interface_level_step"]}
      }
    }
  }
}
