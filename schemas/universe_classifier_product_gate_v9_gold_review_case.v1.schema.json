{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamic-ai-products/schemas/universe_classifier_product_gate_v9_gold_review_case.v1.schema.json",
  "title": "V9 product-gate gold review case v0.1.0",
  "description": "One human-readable, model-blind Item 1 case selected to construct a strict-CORE gold set. It carries packet-derived text and no model label or proposed human decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_contract", "case_id", "cik", "accession", "source_id", "packet_sha256", "source_availability", "item1_passages"],
  "properties": {
    "case_contract": {"const": "universe_classifier_product_gate_v9_gold_review_case@0.1.0"},
    "case_id": {"type": "string", "pattern": "^v9-gold-[0-9]{10}-[A-Za-z0-9-]+$"},
    "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
    "accession": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_availability": {"enum": ["sufficient_item1", "source_insufficient"]},
    "item1_passages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["passage_ref", "passage_id", "byte_start", "byte_end", "text", "text_sha256"],
        "properties": {
          "passage_ref": {"type": "string", "pattern": "^P[0-9]{3}$"},
          "passage_id": {"type": "string", "minLength": 1},
          "byte_start": {"type": "integer", "minimum": 0},
          "byte_end": {"type": "integer", "minimum": 0},
          "text": {"type": "string", "minLength": 1},
          "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
