{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "filer_frame_manifest.schema.json",
  "title": "FRAME filer-frame run manifest",
  "description": "Immutable manifest of one EDGAR full-index frame build (SPEC-001 Stage A; THESIS_EXECUTION_PLAN W1). The filing window is a pair of explicit filing-date admission bounds; fiscal-period assignment is a later PCT/schema concern and is never recorded here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "frame_version",
    "filing_window_start",
    "filing_window_end",
    "domestic_forms",
    "extension_forms",
    "amendment_candidate_rule",
    "index_files",
    "project_config_hash",
    "counts",
    "out_of_scope_form_counts",
    "reconciliation",
    "run_timestamp",
    "schema_versions",
    "output_hashes"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "frame_version": {
      "type": "string"
    },
    "filing_window_start": {
      "type": "string",
      "format": "date"
    },
    "filing_window_end": {
      "type": "string",
      "format": "date"
    },
    "domestic_forms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "extension_forms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "amendment_candidate_rule": {
      "type": "string"
    },
    "index_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filename",
          "sha256",
          "data_lines",
          "parsed_rows",
          "parse_failures"
        ],
        "properties": {
          "filename": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "data_lines": {
            "type": "integer",
            "minimum": 0
          },
          "parsed_rows": {
            "type": "integer",
            "minimum": 0
          },
          "parse_failures": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "project_config_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "code_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "universe_code_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "out_of_scope_form_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "run_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "schema_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
