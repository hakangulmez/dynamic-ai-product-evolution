{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "task_measurement.schema.json",
  "required": [
    "measurement_id",
    "task_observation_id",
    "frontier_baseline_id",
    "replicability",
    "transformation_depth",
    "deployment_scale",
    "defensibility",
    "confidence"
  ],
  "properties": {
    "measurement_id": {
      "type": "string"
    },
    "task_observation_id": {
      "type": "string"
    },
    "frontier_baseline_id": {
      "type": "string"
    },
    "replicability": {
      "type": "object"
    },
    "transformation_depth": {
      "type": "object"
    },
    "deployment_scale": {
      "type": "object"
    },
    "defensibility": {
      "type": "object"
    },
    "task_importance": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "passage_id",
          "quote"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "passage_id": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        }
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "schema_version": {
      "type": "string"
    }
  }
}
