{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acquisition_queue_aggregate_manifest.schema.json",
  "title": "Acquisition queue aggregate manifest",
  "description": "Coverage over completed shards only (ADR-095). Only shards holding both a bundle manifest and an acquisition manifest are admitted; a handled failure and an interrupted shard with no receipt are equally excluded. Coverage below the queue's shard count is reported as partial and never implies completeness. This aggregate hashes shard manifests; no shard manifest hashes it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aggregate_manifest_contract",
    "run_id",
    "queue_id",
    "queue_definition_sha256",
    "execution_run_id",
    "coverage_complete",
    "coverage_statement",
    "shards_authoritative",
    "shards_not_authoritative",
    "counts",
    "run_timestamp",
    "limitations"
  ],
  "properties": {
    "aggregate_manifest_contract": {
      "const": "acquisition_queue_aggregate_manifest@0.1.0"
    },
    "run_id": {
      "type": "string"
    },
    "queue_id": {
      "type": "string"
    },
    "queue_definition_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_run_id": {
      "type": "string"
    },
    "coverage_complete": {
      "type": "boolean"
    },
    "coverage_statement": {
      "type": "string"
    },
    "shards_authoritative": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shard_index",
          "run_id",
          "run_dir",
          "shard_plan_sha256",
          "acquisition_manifest_sha256",
          "bundle_manifest_sha256",
          "accessions",
          "carrier_rows",
          "bundle_entries",
          "total_requests",
          "retained_bytes_total"
        ],
        "properties": {
          "shard_index": {
            "type": "integer",
            "minimum": 0
          },
          "run_id": {
            "type": "string"
          },
          "run_dir": {
            "type": "string"
          },
          "shard_plan_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "acquisition_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bundle_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "accessions": {
            "type": "integer",
            "minimum": 1
          },
          "carrier_rows": {
            "type": "integer",
            "minimum": 1
          },
          "bundle_entries": {
            "type": "integer",
            "minimum": 1
          },
          "total_requests": {
            "type": "integer",
            "minimum": 1
          },
          "retained_bytes_total": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "shards_not_authoritative": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shard_index",
          "run_dir",
          "receipt_present",
          "reason",
          "failure_reason_code"
        ],
        "properties": {
          "shard_index": {
            "type": "integer",
            "minimum": 0
          },
          "run_dir": {
            "type": [
              "string",
              "null"
            ]
          },
          "receipt_present": {
            "type": "boolean"
          },
          "reason": {
            "enum": [
              "no_run_directory",
              "handled_failure",
              "interrupted_or_incomplete"
            ]
          },
          "failure_reason_code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shards_in_queue",
        "shards_authoritative",
        "shards_not_authoritative",
        "accessions_covered",
        "carrier_rows_covered",
        "bundle_entries",
        "total_requests",
        "retained_bytes_total"
      ],
      "properties": {
        "shards_in_queue": {
          "type": "integer",
          "minimum": 1
        },
        "shards_authoritative": {
          "type": "integer",
          "minimum": 0
        },
        "shards_not_authoritative": {
          "type": "integer",
          "minimum": 0
        },
        "accessions_covered": {
          "type": "integer",
          "minimum": 0
        },
        "carrier_rows_covered": {
          "type": "integer",
          "minimum": 0
        },
        "bundle_entries": {
          "type": "integer",
          "minimum": 0
        },
        "total_requests": {
          "type": "integer",
          "minimum": 0
        },
        "retained_bytes_total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "run_timestamp": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
