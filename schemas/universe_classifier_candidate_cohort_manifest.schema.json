{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamic-ai-products/schemas/universe_classifier_candidate_cohort_manifest.schema.json",
  "title": "Universe classifier candidate cohort manifest v0.1.0",
  "description": "ADR-125. The deterministic input cohort for a classifier that has not been built yet. It is neither a screen release nor a classifier output: it is the admission decision, stated once, in a form no existing loader consumes. Counts are derived from the two hash-bound inputs, never declared, so a cohort whose arithmetic does not close is never written.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_contract",
    "cohort_id",
    "cohort_kind",
    "run_timestamp",
    "sources",
    "admission_rule",
    "output_contract",
    "output_hashes",
    "record_order",
    "counts",
    "exclusions",
    "reconciliation",
    "schema_versions",
    "limitations"
  ],
  "properties": {
    "manifest_contract": {
      "const": "universe_classifier_candidate_cohort_manifest@0.1.0"
    },
    "cohort_id": {
      "type": "string",
      "minLength": 1
    },
    "cohort_kind": {
      "const": "classifier_candidate_cohort_v1"
    },
    "run_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "overlay",
        "sources_unmodified",
        "no_model_call"
      ],
      "properties": {
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release_id",
            "manifest_sha256",
            "records_jsonl_sha256"
          ],
          "properties": {
            "release_id": {
              "type": "string",
              "minLength": 1
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "records_jsonl_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "overlay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "overlay_id",
            "manifest_sha256",
            "decisions_jsonl_sha256"
          ],
          "properties": {
            "overlay_id": {
              "type": "string",
              "minLength": 1
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "decisions_jsonl_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "sources_unmodified": {
          "const": true
        },
        "no_model_call": {
          "const": true
        }
      }
    },
    "admission_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "admitted_statuses",
        "admitted_origins",
        "human_ineligible_admitted"
      ],
      "properties": {
        "rule": {
          "const": "eligible_or_boundary_from_screen_or_review@1"
        },
        "admitted_statuses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "enum": [
              "LIKELY_ELIGIBLE",
              "BOUNDARY_OR_UNCERTAIN"
            ]
          }
        },
        "admitted_origins": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "enum": [
              "model_screen",
              "human_review"
            ]
          }
        },
        "human_ineligible_admitted": {
          "description": "A reviewer's LIKELY_INELIGIBLE decision is retained in the overlay for audit and admitted nowhere.",
          "const": false
        }
      }
    },
    "output_contract": {
      "const": "universe_classifier_candidate_record@0.1.0"
    },
    "output_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universe_classifier_candidate_records.jsonl"
      ],
      "properties": {
        "universe_classifier_candidate_records.jsonl": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "record_order": {
      "const": "release_row_order"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_rows",
        "model_screen_admitted",
        "human_review_admitted",
        "by_admission_origin_and_status",
        "by_screen_status"
      ],
      "properties": {
        "cohort_rows": {
          "type": "integer",
          "minimum": 0
        },
        "model_screen_admitted": {
          "type": "integer",
          "minimum": 0
        },
        "human_review_admitted": {
          "type": "integer",
          "minimum": 0
        },
        "by_admission_origin_and_status": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "by_screen_status": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_likely_ineligible",
        "human_likely_ineligible",
        "insufficient_evidence",
        "model_output_truncated",
        "unresolved_without_admission",
        "excluded_rows_total"
      ],
      "properties": {
        "model_likely_ineligible": {
          "type": "integer",
          "minimum": 0
        },
        "human_likely_ineligible": {
          "type": "integer",
          "minimum": 0
        },
        "insufficient_evidence": {
          "type": "integer",
          "minimum": 0
        },
        "model_output_truncated": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_without_admission": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_rows_total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "minProperties": 14,
      "additionalProperties": {
        "const": true
      }
    },
    "schema_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
