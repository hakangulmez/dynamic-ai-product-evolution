{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "universe_screen_record.schema.json",
  "title": "Universe high-recall screen record (v0.1, lineage-bound production screen)",
  "description": "One row of the production high-recall screen over a v0.5 baseline-packet cohort (ADR-108). Exactly two record kinds exist. A screened_packet row carries the packet's own baseline_filing_date, one of the three closed model statuses, the packet's content hash, the rendered prompt hash, the model route, the raw-response binding (id plus SHA-256 over the verbatim response bytes, resolvable in the run's raw archive), and the validated screen output. An insufficient_evidence row preserves a packet-build failure: its only authority is the v0.5 failures JSONL, which measurably carries no filing date, so baseline_filing_date is null by contract and never derived from a carrier or any other source; screen_status is null because INSUFFICIENT_EVIDENCE is a roll-up state, never a fourth model status; every model, prompt, raw-response and evidence field is null because no model call happened for the row. The mutual-exclusion conditionals below make each kind reject the other's shape, so the 530-analog rows cannot masquerade as screened rows and a screened row cannot drop its evidence. Identity stays at raw (cik, accession) grain: shared accessions remain separate rows per CIK and no corporate merge exists at this stage. A screen status is a recall decision only - it is never final sample membership and never software eligibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_contract",
    "record_kind",
    "cik",
    "company_id",
    "accession",
    "form",
    "baseline_filing_date",
    "source_id",
    "packet_sha256",
    "screen_status",
    "prompt_sha256",
    "model_route",
    "raw_response_id",
    "raw_response_sha256",
    "screen_output",
    "failure_reason_code",
    "failure_detail"
  ],
  "properties": {
    "record_contract": {
      "const": "universe_screen_record@0.1.0"
    },
    "record_kind": {
      "enum": [
        "screened_packet",
        "insufficient_evidence"
      ]
    },
    "cik": {
      "type": "string",
      "pattern": "^\\d{10}$"
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "accession": {
      "type": "string",
      "pattern": "^\\d{10}-\\d{2}-\\d{6}$"
    },
    "form": {
      "enum": [
        "10-K",
        "10-KT"
      ]
    },
    "baseline_filing_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "source_id": {
      "type": "string",
      "pattern": "^sec-primary:\\d{10}:\\d{10}-\\d{2}-\\d{6}:.+$"
    },
    "packet_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "screen_status": {
      "description": "The closed three-value model vocabulary, or null on a row no model saw. INSUFFICIENT_EVIDENCE is deliberately not a member: it exists only at firm roll-up.",
      "enum": [
        "LIKELY_ELIGIBLE",
        "LIKELY_INELIGIBLE",
        "BOUNDARY_OR_UNCERTAIN",
        null
      ]
    },
    "prompt_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_route": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "provider",
        "model_label"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model_label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "raw_response_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "raw_response_sha256": {
      "description": "SHA-256 over the exact original response bytes, computed before any parsing. Resolvable by raw_response_id in the run's raw-responses archive, whose file hash the run manifest's output_hashes covers.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "screen_output": {
      "description": "The validated model output. The closed archetype vocabulary is enforced by the governing pydantic contract; this schema pins the structural shape.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cik",
            "company_id",
            "screen_status",
            "plausible_customer_facing_digital_product",
            "candidate_customer_value_archetypes",
            "positive_evidence",
            "negative_or_boundary_evidence",
            "missing_evidence",
            "confidence"
          ],
          "properties": {
            "cik": {
              "type": "string",
              "pattern": "^\\d{10}$"
            },
            "company_id": {
              "type": "string",
              "minLength": 1
            },
            "screen_status": {
              "enum": [
                "LIKELY_ELIGIBLE",
                "LIKELY_INELIGIBLE",
                "BOUNDARY_OR_UNCERTAIN"
              ]
            },
            "plausible_customer_facing_digital_product": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "candidate_customer_value_archetypes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "positive_evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/screen_evidence"
              }
            },
            "negative_or_boundary_evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/screen_evidence"
              }
            },
            "missing_evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "screen_status": {
                    "const": "LIKELY_ELIGIBLE"
                  }
                }
              },
              "then": {
                "properties": {
                  "positive_evidence": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "failure_reason_code": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "failure_detail": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "screened_packet"
          }
        }
      },
      "then": {
        "properties": {
          "baseline_filing_date": {
            "type": "string",
            "format": "date"
          },
          "packet_sha256": {
            "type": "string"
          },
          "screen_status": {
            "enum": [
              "LIKELY_ELIGIBLE",
              "LIKELY_INELIGIBLE",
              "BOUNDARY_OR_UNCERTAIN"
            ]
          },
          "prompt_sha256": {
            "type": "string"
          },
          "model_route": {
            "type": "object"
          },
          "raw_response_id": {
            "type": "string"
          },
          "raw_response_sha256": {
            "type": "string"
          },
          "screen_output": {
            "type": "object"
          },
          "failure_reason_code": {
            "type": "null"
          },
          "failure_detail": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "insufficient_evidence"
          }
        }
      },
      "then": {
        "properties": {
          "baseline_filing_date": {
            "type": "null"
          },
          "packet_sha256": {
            "type": "null"
          },
          "screen_status": {
            "type": "null"
          },
          "prompt_sha256": {
            "type": "null"
          },
          "model_route": {
            "type": "null"
          },
          "raw_response_id": {
            "type": "null"
          },
          "raw_response_sha256": {
            "type": "null"
          },
          "screen_output": {
            "type": "null"
          },
          "failure_reason_code": {
            "type": "string"
          },
          "failure_detail": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$defs": {
    "screen_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "passage_id",
        "quote",
        "supported_claim"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "passage_id": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "supported_claim": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
