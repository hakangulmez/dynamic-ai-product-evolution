{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamic-ai-products/schemas/universe_classifier_product_gate_v9_aggregate_manifest.v1.schema.json",
  "title": "V9 product-gate full-coverage aggregate manifest v0.1.0",
  "description": "Hash-bound aggregate of every planned V9 product-gate batch. It separates model-derived software candidates, strict CORE rows, and unresolved rows; it does not substitute for human semantic review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["aggregate_contract", "aggregate_id", "run_timestamp", "prompt_template_path", "prompt_template_sha256", "batch_plan_path", "batch_plan_sha256", "coverage_cohort_id", "coverage_cohort_manifest_sha256", "batch_runs", "output_hashes", "counts", "reconciliation", "promotable", "limitations"],
  "properties": {
    "aggregate_contract": {"const": "universe_classifier_product_gate_v9_aggregate_manifest@0.1.0"},
    "aggregate_id": {"type": "string", "minLength": 1},
    "run_timestamp": {"type": "string", "format": "date-time"},
    "prompt_template_path": {"const": "prompts/discovery/software_universe_classifier_pilot.v9.md"},
    "prompt_template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "batch_plan_path": {"type": "string", "minLength": 1},
    "batch_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coverage_cohort_id": {"type": "string", "minLength": 1},
    "coverage_cohort_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "batch_runs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["batch_id", "batch_ordinal", "run_id", "run_dir", "manifest_sha256", "records_sha256"], "properties": {"batch_id": {"type": "string", "pattern": "^batch-[0-9]{4}$"}, "batch_ordinal": {"type": "integer", "minimum": 1}, "run_id": {"type": "string", "minLength": 1}, "run_dir": {"type": "string", "minLength": 1}, "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "records_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "output_hashes": {"type": "object", "additionalProperties": false, "required": ["universe_classifier_product_gate_v9_software_candidates.jsonl", "universe_classifier_product_gate_v9_core_software.jsonl", "universe_classifier_product_gate_v9_unresolved.jsonl"], "properties": {"universe_classifier_product_gate_v9_software_candidates.jsonl": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "universe_classifier_product_gate_v9_core_software.jsonl": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "universe_classifier_product_gate_v9_unresolved.jsonl": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["planned_rows", "classified_rows", "review_uncertain_rows", "software_candidate_rows", "core_software_rows", "no_or_unknown_rows"], "properties": {"planned_rows": {"type": "integer", "minimum": 1}, "classified_rows": {"type": "integer", "minimum": 0}, "review_uncertain_rows": {"type": "integer", "minimum": 0}, "software_candidate_rows": {"type": "integer", "minimum": 0}, "core_software_rows": {"type": "integer", "minimum": 0}, "no_or_unknown_rows": {"type": "integer", "minimum": 0}}},
    "reconciliation": {"type": "object", "minProperties": 1, "additionalProperties": {"const": true}},
    "promotable": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
