{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamic-ai-products/schemas/universe_classifier_product_gate_batch_plan.v1.schema.json",
  "title": "Product-gate full-cohort batch plan v0.1.0",
  "description": "Deterministic, model-free partition of one annual-coverage cohort into fixed 100-row product-gate batches. It is a plan, not a software-universe result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_plan_contract", "batch_plan_id", "selection_kind", "batch_size", "coverage_cohort", "batches", "counts", "no_model_call", "is_software_universe", "is_classifier_output", "covers_full_coverage_cohort", "reconciliation", "run_timestamp", "limitations"],
  "properties": {
    "batch_plan_contract": {"const": "universe_classifier_product_gate_batch_plan@0.1.0"},
    "batch_plan_id": {"type": "string", "minLength": 1},
    "selection_kind": {"const": "classifier_product_gate_batch_plan_v1"},
    "batch_size": {"const": 100},
    "coverage_cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_cohort_id", "manifest_path", "manifest_sha256", "records_jsonl_sha256", "included_rows"],
      "properties": {
        "coverage_cohort_id": {"type": "string", "minLength": 1},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "records_jsonl_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "included_rows": {"type": "integer", "minimum": 1}
      }
    },
    "batches": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/batch"}
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["selected_rows", "batch_count", "full_batches", "final_batch_rows"],
      "properties": {
        "selected_rows": {"type": "integer", "minimum": 1},
        "batch_count": {"type": "integer", "minimum": 1},
        "full_batches": {"type": "integer", "minimum": 0},
        "final_batch_rows": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "no_model_call": {"const": true},
    "is_software_universe": {"const": false},
    "is_classifier_output": {"const": false},
    "covers_full_coverage_cohort": {"const": true},
    "reconciliation": {"type": "object", "minProperties": 1, "additionalProperties": {"const": true}},
    "run_timestamp": {"type": "string", "format": "date-time"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "batch": {
      "type": "object", "additionalProperties": false,
      "required": ["batch_id", "batch_ordinal", "first_row_ordinal", "last_row_ordinal", "rows"],
      "properties": {
        "batch_id": {"type": "string", "pattern": "^batch-[0-9]{4}$"},
        "batch_ordinal": {"type": "integer", "minimum": 1},
        "first_row_ordinal": {"type": "integer", "minimum": 1},
        "last_row_ordinal": {"type": "integer", "minimum": 1},
        "rows": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/row"}}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["cik", "accession", "company_id", "source_id", "packet_sha256", "admission_origin", "screen_status", "admission_provenance", "coverage_class", "observed_annual_filing_years"],
      "properties": {
        "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
        "accession": {"type": "string", "minLength": 1},
        "company_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "admission_origin": {"enum": ["model_screen", "human_review"]},
        "screen_status": {"enum": ["LIKELY_ELIGIBLE", "BOUNDARY_OR_UNCERTAIN"]},
        "admission_provenance": {"type": "object"},
        "coverage_class": {"enum": ["complete_2021_2025", "2021_missing_2022_2025_present"]},
        "observed_annual_filing_years": {"type": "array", "minItems": 4, "items": {"type": "integer"}}
      }
    }
  }
}
