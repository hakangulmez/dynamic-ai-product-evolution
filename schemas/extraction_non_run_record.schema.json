{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extraction_non_run_record.schema.json",
  "title": "Extraction non-run record",
  "description": "The sole newly published output of a pre-provider non-run route (ADR-033). No extraction_run@0.1.0 is written on that route: that contract requires prompt_hash and source_manifest_hash and denotes a provider run, so emitting one with a stopped status would assert a run that never began. The record pins the canonical input packet by reference and SHA-256; the filter ledger sits beside those bytes as explanatory data, never as a substitute for them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "extraction_run_id",
    "stage",
    "company_id",
    "observation_cutoff_date",
    "code_commit",
    "run_created_at",
    "input_packet_reference",
    "input_packet_sha256",
    "coverage_artifact_reference",
    "coverage_artifact_sha256",
    "reason_code",
    "filter_ledger",
    "provider_called",
    "harness_run"
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "properties": {
    "contract": { "const": "extraction_non_run_record@0.1.0" },
    "schema_version": { "const": "0.1.0" },
    "extraction_run_id": { "type": "string", "minLength": 1 },
    "stage": {
      "enum": ["product_extraction", "capability_extraction", "task_extraction"]
    },
    "company_id": { "type": "string", "pattern": "^CIK[0-9]{10}$" },
    "observation_cutoff_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "code_commit": {
      "comment": "Caller-injected. This package reads no VCS.",
      "type": "string",
      "minLength": 1
    },
    "run_created_at": {
      "comment": "Caller-injected. This package reads no clock.",
      "type": "string",
      "minLength": 1
    },
    "input_packet_reference": { "type": "string", "minLength": 1 },
    "input_packet_sha256": { "$ref": "#/$defs/sha256" },
    "coverage_artifact_reference": { "type": "string", "minLength": 1 },
    "coverage_artifact_sha256": { "$ref": "#/$defs/sha256" },
    "reason_code": {
      "enum": [
        "zero_admissible_passages",
        "all_passages_temporally_invalid",
        "input_packet_empty_after_filters",
        "corpus_binding_unverified",
        "source_snapshot_unavailable"
      ]
    },
    "filter_ledger": {
      "type": "object",
      "required": [
        "input_passage_count",
        "blank_drop_count",
        "temporal_drop_count",
        "surviving_count"
      ],
      "properties": {
        "input_passage_count": { "type": "integer", "minimum": 0 },
        "blank_drop_count": { "type": "integer", "minimum": 0 },
        "temporal_drop_count": { "type": "integer", "minimum": 0 },
        "surviving_count": { "type": "integer", "minimum": 0 },
        "blank_drops": { "type": "array" },
        "temporal_drops": { "type": "array" }
      }
    },
    "provider_called": { "const": false },
    "harness_run": { "const": false }
  }
}
