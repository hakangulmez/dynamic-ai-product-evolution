{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "universe_screen_manifest.v7.schema.json",
  "title": "Universe high-recall screen run manifest (v0.7, long 429 backoff)",
  "description": "Immutable authoritative output manifest for ADR-117. The row semantics are the v0.6 ones unchanged - valid packets partition into screened_packet and model_evidence_unverified, packet-build failures remain insufficient_evidence, and MODEL_EVIDENCE_UNVERIFIED is a visible non-negative review state - and what this generation adds is the transport policy the run actually executed under. generate_retry_policy is a const block, so the manifest states, rather than implies, that each logical packet had five generate attempts with fixed 15s/30s/60s/120s waits and exactly one countTokens send. The provider block names the retry owner (vertex_gemini_screen_v3) alongside the unchanged wire connector and client contract. request_accounting pins the per-row arithmetic that the runner re-derives relationally: provider_attempt_cap is logical_request_cap times five and external_request_cap is logical_request_cap times six. The manifest_contract const is what makes generations mutually exclusive: a v0.5, v0.6 or v0.7 manifest is refused by the other two schemas even though all three are written under the same authoritative filename.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_contract", "run_id", "packet_manifest_path", "packet_manifest_sha256", "packet_run_id", "packets_jsonl_sha256", "packet_failures_jsonl_sha256", "prompt_template_path", "prompt_template_sha256", "authorization_id", "authorization_sha256", "screen_adapter_enablement_sha256", "provider_client_contract_reference", "provider_client_contract_sha256", "envelope_text_extraction_rule", "selection", "provider", "generate_retry_policy", "screen_record_order", "firm_rollup_rule", "baseline_cutoff", "counts", "request_accounting", "reconciliation", "output_hashes", "run_timestamp", "schema_versions", "limitations"],
  "properties": {
    "manifest_contract": {"const": "universe_screen_manifest@0.7.0"}, "run_id": {"type": "string", "minLength": 1},
    "packet_manifest_path": {"type": "string", "minLength": 1}, "packet_manifest_sha256": {"$ref": "#/$defs/sha256"}, "packet_run_id": {"type": "string", "minLength": 1}, "packets_jsonl_sha256": {"$ref": "#/$defs/sha256"}, "packet_failures_jsonl_sha256": {"$ref": "#/$defs/sha256"},
    "prompt_template_path": {"const": "prompts/discovery/universe_high_recall_screen.v5.md"}, "prompt_template_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_id": {"type": "string", "minLength": 1}, "authorization_sha256": {"$ref": "#/$defs/sha256"}, "screen_adapter_enablement_sha256": {"$ref": "#/$defs/sha256"},
    "provider_client_contract_reference": {"type": "string", "minLength": 1}, "provider_client_contract_sha256": {"$ref": "#/$defs/sha256"}, "envelope_text_extraction_rule": {"const": "vertex_generate_content_candidates0_text_parts@1"},
    "selection": {"type": "object", "additionalProperties": false, "required": ["selection_artifact_path", "selection_artifact_sha256", "selection_kind", "sampling_algorithm", "seed", "rows_selected"], "properties": {"selection_artifact_path": {"type": "string", "minLength": 1}, "selection_artifact_sha256": {"$ref": "#/$defs/sha256"}, "selection_kind": {"enum": ["canary_100", "full_cohort"]}, "sampling_algorithm": {"type": "string", "minLength": 1}, "seed": {"type": ["integer", "null"]}, "rows_selected": {"type": "integer", "minimum": 1}}},
    "provider": {"type": "object", "additionalProperties": false, "required": ["name", "connector", "model_route"], "properties": {"name": {"description": "The unchanged wire connector and protocol; only the retry owner differs from v0.6.", "const": "vertex_gemini_v2"}, "connector": {"const": "vertex_gemini_screen_v3"}, "model_route": {"type": "object"}}},
    "generate_retry_policy": {"type": "object", "additionalProperties": false, "required": ["policy_version", "retry_owner", "generate_max_attempts", "generate_retry_delays_seconds", "jitter", "count_max_attempts", "external_requests_per_row"], "properties": {"policy_version": {"const": "universe_screen_generate_retry_policy_v1"}, "retry_owner": {"const": "tenacity"}, "generate_max_attempts": {"const": 5}, "generate_retry_delays_seconds": {"const": [15, 30, 60, 120]}, "jitter": {"const": false}, "count_max_attempts": {"const": 1}, "external_requests_per_row": {"const": 6}}},
    "screen_record_order": {"const": "selected_packets_then_packet_failures@2"}, "firm_rollup_rule": {"const": "eligible_over_boundary_over_model_evidence_unverified_over_ineligible_over_insufficient@1"}, "baseline_cutoff": {"type": "string", "format": "date"},
    "counts": {"type": "object"},
    "request_accounting": {"type": "object", "required": ["logical_request_cap", "provider_attempt_cap", "external_request_cap", "generate_attempt_cap_per_row", "external_requests_per_row", "logical_requests_made", "provider_attempts_made", "external_requests_made", "rows_retried"], "properties": {"generate_attempt_cap_per_row": {"const": 5}, "external_requests_per_row": {"const": 6}}},
    "reconciliation": {"type": "object", "minProperties": 12, "additionalProperties": {"type": "boolean"}},
    "output_hashes": {"type": "object", "additionalProperties": false, "required": ["universe_screen_records.jsonl", "universe_screen_raw_responses.jsonl", "universe_screen_capture_ledger.jsonl"], "properties": {"universe_screen_records.jsonl": {"$ref": "#/$defs/sha256"}, "universe_screen_raw_responses.jsonl": {"$ref": "#/$defs/sha256"}, "universe_screen_capture_ledger.jsonl": {"$ref": "#/$defs/sha256"}}},
    "run_timestamp": {"type": "string", "minLength": 1},
    "schema_versions": {"type": "object", "additionalProperties": false, "required": ["universe_screen_record_v2", "universe_screen_manifest_v7", "universe_screen_live_authorization_v3", "universe_screen_selection", "universe_screen_adapter_enablement", "baseline_packet_manifest_v5", "universe_baseline_packet_v2"], "properties": {"universe_screen_record_v2": {"const": "0.2.0"}, "universe_screen_manifest_v7": {"const": "0.7.0"}, "universe_screen_live_authorization_v3": {"const": "0.3.0"}, "universe_screen_selection": {"const": "0.1.0"}, "universe_screen_adapter_enablement": {"const": "0.1.0"}, "baseline_packet_manifest_v5": {"const": "0.5.0"}, "universe_baseline_packet_v2": {"const": "0.2.0"}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
