{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pct_item1_tasks_flat_output.v1.schema.json",
  "title": "PCT Item 1 flat task output v1",
  "description": "Development-only task-only output over a saved economic-product and capability candidate map.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tasks"],
  "properties": {"tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}},
  "$defs": {
    "passage_refs": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^P[0-9]{3}$"}},
    "task": {"type": "object", "additionalProperties": false, "required": ["id", "economic_product_id", "capability_ids", "text", "passage_refs"], "properties": {"id": {"type": "string", "pattern": "^T[1-9][0-9]*$"}, "economic_product_id": {"type": "string", "pattern": "^EP[1-9][0-9]*$"}, "capability_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[1-9][0-9]*$"}}, "text": {"type": "string", "minLength": 1}, "passage_refs": {"$ref": "#/$defs/passage_refs"}}}
  }
}
