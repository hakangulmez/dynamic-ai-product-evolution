{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamic-ai-products/schemas/universe_classifier_pilot_manifest.v1.schema.json",
  "title": "Software universe classifier pilot manifest v0.1.0",
  "description": "The run manifest for one ten-firm firm-level pilot. It binds every input by digest -- prompt, selection, cohort, packet cohort, provider client contract -- and every output by digest, and it reports what the run produced: how many rows were classified, and how many were stored as review_uncertain, broken out by reason. It carries no tier distribution, because the pilot derives no tier; no bounded-outcome tolerances, because it has none; and no full-cohort coverage claim, because ten named filings are not a universe. The limitations block is required and is not decoration: this manifest states in its own bytes that the run is non-promotable, settles no firm's membership, and licenses no extrapolation beyond its ten rows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_id",
    "authorization_sha256",
    "counts",
    "endpoint_allowlist",
    "envelope_text_extraction_rule",
    "limitations",
    "manifest_contract",
    "output_axes_contract",
    "output_contract",
    "output_hashes",
    "promotable",
    "prompt_template_path",
    "prompt_template_sha256",
    "provider",
    "provider_client_contract_reference",
    "provider_client_contract_sha256",
    "reconciliation",
    "record_order",
    "request_accounting",
    "run_id",
    "run_kind",
    "run_timestamp",
    "schema_versions",
    "screen_adapter_enablement_sha256",
    "sources",
    "covers_full_cohort",
    "derives_no_tier",
    "settles_no_membership"
  ],
  "properties": {
    "manifest_contract": {
      "const": "universe_classifier_pilot_manifest@0.1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_kind": {
      "const": "classifier_pilot_v1"
    },
    "run_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "promotable": {
      "const": false
    },
    "covers_full_cohort": {
      "description": "Always false. Ten named filings are neither a universe nor a sample of one, and no reader may treat this run as covering the cohort.",
      "const": false
    },
    "derives_no_tier": {
      "description": "Always true, and structural rather than advisory: there is no tier field anywhere in the pilot record contract and the runner imports no tier engine. Stated in the manifest so a consumer can refuse to look for a tier rather than find none and infer one.",
      "const": true
    },
    "settles_no_membership": {
      "description": "Always true. The pilot decides no firm's inclusion in any universe and nothing downstream may consume it as a decision.",
      "const": true
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "authorization_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_template_path": {
      "const": "prompts/discovery/software_universe_classifier_pilot.v1.md"
    },
    "prompt_template_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_contract": {
      "const": "universe_classifier_pilot_record@0.1.0"
    },
    "output_axes_contract": {
      "const": "universe_classifier_pilot_axes_record@0.1.0"
    },
    "record_order": {
      "const": "pilot_selection_row_order"
    },
    "envelope_text_extraction_rule": {
      "type": "string",
      "minLength": 1
    },
    "screen_adapter_enablement_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_label"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model_label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provider_client_contract_reference": {
      "type": "string",
      "minLength": 1
    },
    "provider_client_contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "endpoint_allowlist": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "sources": {
      "description": "Every input this run read, bound by digest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort",
        "packet",
        "selection",
        "sources_unmodified"
      ],
      "properties": {
        "cohort": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cohort_id",
            "manifest_sha256",
            "records_jsonl_sha256"
          ],
          "properties": {
            "cohort_id": {
              "type": "string",
              "minLength": 1
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "records_jsonl_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "packet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packet_manifest_path",
            "packet_manifest_sha256",
            "packets_jsonl_sha256"
          ],
          "properties": {
            "packet_manifest_path": {
              "type": "string",
              "minLength": 1
            },
            "packet_manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "packets_jsonl_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selection_artifact_path",
            "selection_artifact_sha256",
            "selection_id",
            "selection_kind",
            "selected_rows",
            "source_selection_path",
            "source_selection_sha256"
          ],
          "properties": {
            "selection_artifact_path": {
              "type": "string",
              "minLength": 1
            },
            "selection_artifact_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "selection_id": {
              "type": "string",
              "minLength": 1
            },
            "selection_kind": {
              "const": "classifier_pilot_v1"
            },
            "selected_rows": {
              "const": 10
            },
            "source_selection_path": {
              "description": "The 40-row calibration selection the ten were drawn from. Recorded because it is what makes them a chosen subset rather than an independent sample.",
              "type": "string",
              "minLength": 1
            },
            "source_selection_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "sources_unmodified": {
          "const": true
        }
      }
    },
    "output_hashes": {
      "description": "Every artifact this run wrote, by filename and digest: the records JSONL, the raw-response archive, and the capture ledger.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universe_classifier_pilot_v1_records.jsonl",
        "universe_classifier_pilot_v1_raw_responses.jsonl",
        "universe_screen_capture_ledger.jsonl"
      ],
      "properties": {
        "universe_classifier_pilot_v1_records.jsonl": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "universe_classifier_pilot_v1_raw_responses.jsonl": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "universe_screen_capture_ledger.jsonl": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "counts": {
      "description": "What the run produced. The two record kinds partition the ten rows, and the review breakdown accounts for every review_uncertain row by reason.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_rows",
        "classified",
        "review_uncertain",
        "review_uncertain_by_reason",
        "by_admission_origin",
        "by_pilot_stratum",
        "by_confidence",
        "by_customer_facing_functional_product",
        "by_software_centrality",
        "by_firm_structure",
        "by_commercial_materiality",
        "evidence_items",
        "rows_with_no_evidence"
      ],
      "properties": {
        "selected_rows": {
          "const": 10
        },
        "classified": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "review_uncertain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "review_uncertain_by_reason": {
          "description": "Keyed by the closed review-reason vocabulary. A reason that did not occur is absent rather than zero, and the values sum to review_uncertain.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "invalid_model_json": {
              "type": "integer",
              "minimum": 1
            },
            "pilot_axes_contract_violation": {
              "type": "integer",
              "minimum": 1
            },
            "model_emitted_forbidden_field": {
              "type": "integer",
              "minimum": 1
            },
            "evidence_reference_unresolvable": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "by_admission_origin": {
          "type": "object"
        },
        "by_pilot_stratum": {
          "type": "object"
        },
        "by_confidence": {
          "type": "object"
        },
        "by_customer_facing_functional_product": {
          "type": "object"
        },
        "by_software_centrality": {
          "type": "object"
        },
        "by_firm_structure": {
          "type": "object"
        },
        "by_commercial_materiality": {
          "type": "object"
        },
        "evidence_items": {
          "description": "Total stored evidence blocks across every classified row. Zero to three per row.",
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "rows_with_no_evidence": {
          "description": "Classified rows citing nothing. Each is an all-UNKNOWN row: the contract admits an empty evidence array only then.",
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "request_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_row_cap",
        "count_attempt_cap",
        "provider_attempt_cap",
        "external_request_cap",
        "count_attempts_made",
        "provider_attempts_made",
        "external_requests_made",
        "rows_count_retried",
        "rows_generate_retried",
        "model_called_rows",
        "tokens_in_measured",
        "tokens_out_reported",
        "rows_usage_verified",
        "cost_micros_settled",
        "budget_max_input_tokens",
        "budget_max_output_tokens",
        "budget_max_estimated_cost_micros",
        "budget_max_wall_clock_seconds"
      ],
      "properties": {
        "logical_row_cap": {
          "const": 10
        },
        "count_attempt_cap": {
          "const": 30
        },
        "provider_attempt_cap": {
          "const": 50
        },
        "external_request_cap": {
          "const": 80
        },
        "count_attempts_made": {
          "type": "integer",
          "minimum": 0
        },
        "provider_attempts_made": {
          "type": "integer",
          "minimum": 0
        },
        "external_requests_made": {
          "type": "integer",
          "minimum": 0
        },
        "rows_count_retried": {
          "type": "integer",
          "minimum": 0
        },
        "rows_generate_retried": {
          "type": "integer",
          "minimum": 0
        },
        "model_called_rows": {
          "const": 10
        },
        "tokens_in_measured": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_out_reported": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "rows_usage_verified": {
          "type": "integer",
          "minimum": 0
        },
        "cost_micros_settled": {
          "type": "integer",
          "minimum": 0
        },
        "budget_max_input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "budget_max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "budget_max_estimated_cost_micros": {
          "type": "integer",
          "minimum": 1
        },
        "budget_max_wall_clock_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "reconciliation": {
      "description": "Named identities, each proved true before this manifest was written. A false value means no manifest exists.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "const": true
      }
    },
    "schema_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universe_classifier_pilot_axes_record",
        "universe_classifier_pilot_record",
        "universe_classifier_pilot_manifest",
        "universe_classifier_pilot_selection",
        "screen_connector"
      ],
      "properties": {
        "universe_classifier_pilot_axes_record": {
          "type": "string",
          "minLength": 1
        },
        "universe_classifier_pilot_record": {
          "type": "string",
          "minLength": 1
        },
        "universe_classifier_pilot_manifest": {
          "type": "string",
          "minLength": 1
        },
        "universe_classifier_pilot_selection": {
          "type": "string",
          "minLength": 1
        },
        "screen_connector": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
