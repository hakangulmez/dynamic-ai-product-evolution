{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamic-ai-products/schemas/universe_classifier_pilot_record.v3.schema.json",
  "title": "Software universe classifier pilot record v0.3.0",
  "description": "Stored record for the Item 1 product gate. A classified row preserves the model's two judgements and Item 1 addresses alongside pipeline-derived evidence. Product NO or UNKNOWN requires centrality UNKNOWN. No tier or membership decision is stored.",
  "type": "object", "additionalProperties": false,
  "required": ["record_contract", "record_kind", "cik", "accession", "company_id", "source_id", "packet_sha256", "prompt_sha256", "model_route", "admission_provenance", "axes", "review_reason_code", "review_detail"],
  "properties": {
    "record_contract": {"const": "universe_classifier_pilot_record@0.3.0"},
    "record_kind": {"enum": ["classified", "review_uncertain"]},
    "cik": {"type": "string", "pattern": "^[0-9]{10}$"}, "accession": {"type": "string", "minLength": 1}, "company_id": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1}, "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "model_route": {"type": "object"}, "admission_provenance": {"type": "object"},
    "axes": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["customer_facing_digital_product", "software_centrality", "confidence", "passage_refs", "evidence"], "properties": {
      "customer_facing_digital_product": {"enum": ["YES", "NO", "UNKNOWN"]}, "software_centrality": {"enum": ["CORE", "CO_ESSENTIAL", "ENABLING", "PERIPHERAL", "UNKNOWN"]}, "confidence": {"enum": ["high", "medium", "low"]},
      "passage_refs": {"type": "array", "minItems": 0, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^P[0-9]{3}$"}},
      "evidence": {"type": "array", "minItems": 0, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["passage_ref", "passage_id", "evidence_text", "byte_start", "byte_end", "text_sha256", "provenance"], "properties": {"passage_ref": {"type": "string", "pattern": "^P[0-9]{3}$"}, "passage_id": {"type": "string", "minLength": 1}, "evidence_text": {"type": "string", "minLength": 1}, "byte_start": {"type": "integer", "minimum": 0}, "byte_end": {"type": "integer", "minimum": 1}, "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "provenance": {"const": "pipeline_derived"}}}}
    }, "allOf": [
      {"if": {"properties": {"passage_refs": {"maxItems": 0}}, "required": ["passage_refs"]}, "then": {"properties": {"customer_facing_digital_product": {"const": "UNKNOWN"}, "software_centrality": {"const": "UNKNOWN"}, "evidence": {"maxItems": 0}}}},
      {"if": {"properties": {"customer_facing_digital_product": {"enum": ["NO", "UNKNOWN"]}}, "required": ["customer_facing_digital_product"]}, "then": {"properties": {"software_centrality": {"const": "UNKNOWN"}}}}
    ]}]},
    "review_reason_code": {"type": ["string", "null"]}, "review_detail": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"record_kind": {"const": "classified"}}}, "then": {"properties": {"axes": {"type": "object"}, "review_reason_code": {"type": "null"}, "review_detail": {"type": "null"}}}},
    {"if": {"properties": {"record_kind": {"const": "review_uncertain"}}}, "then": {"properties": {"axes": {"type": "null"}, "review_reason_code": {"type": "string", "minLength": 1}, "review_detail": {"type": "string", "minLength": 1}}}}
  ]
}
