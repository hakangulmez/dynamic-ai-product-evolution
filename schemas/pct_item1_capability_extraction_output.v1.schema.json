{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pct_item1_capability_extraction_output.v1.schema.json",
  "title": "PCT Item 1 capability-extraction model output v1",
  "description": "Development-only capability output over a fixed economic-product map. The model cannot alter product identities or boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["economic_product_capabilities"],
  "properties": {"economic_product_capabilities": {"type": "array", "items": {"$ref": "#/$defs/product_capabilities"}}},
  "$defs": {
    "passage_refs": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^P[0-9]{3}$"}},
    "capability": {"type": "object", "additionalProperties": false, "required": ["id", "text", "passage_refs"], "properties": {"id": {"type": "string", "pattern": "^C[1-9][0-9]*$"}, "text": {"type": "string", "minLength": 1}, "passage_refs": {"$ref": "#/$defs/passage_refs"}}},
    "product_capabilities": {"type": "object", "additionalProperties": false, "required": ["economic_product_id", "capabilities"], "properties": {"economic_product_id": {"type": "string", "pattern": "^EP[1-9][0-9]*$"}, "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}}}}
  }
}
