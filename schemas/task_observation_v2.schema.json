{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "task_observation_v2.schema.json",
  "required": [
    "task_observation_id",
    "company_id",
    "observation_cutoff",
    "product_observation_id",
    "capability_observation_ids",
    "task",
    "normalized_task",
    "customer_need",
    "availability_status",
    "evidence",
    "confidence"
  ],
  "properties": {
    "task_observation_id": {
      "type": "string"
    },
    "stable_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "company_id": {
      "type": "string"
    },
    "observation_cutoff": {
      "type": "string",
      "format": "date"
    },
    "product_observation_id": {
      "type": "string"
    },
    "capability_observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task": {
      "type": "string"
    },
    "normalized_task": {
      "type": "string"
    },
    "customer_need": {
      "type": "string"
    },
    "task_role": {
      "enum": [
        "core",
        "major_supporting",
        "peripheral",
        "unknown"
      ]
    },
    "availability_status": {
      "type": "string"
    },
    "target_customer": {
      "type": [
        "string",
        "null"
      ]
    },
    "monetization_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_action_observed": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "passage_id",
          "quote"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "passage_id": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        }
      }
    },
    "ambiguity": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "schema_version": {
      "type": "string"
    }
  }
}
