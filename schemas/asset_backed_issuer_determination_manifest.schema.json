{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset_backed_issuer_determination_manifest.schema.json",
  "title": "Asset-backed issuer determination run manifest (v0.1, lineage)",
  "description": "Immutable record of one ADR-105 asset-backed-issuer determination run over a whole acquisition lineage. The ADR-101 aggregate is the sole authority root, bound by path, recomputed hash and run id; every consumed shard is listed; records are written in shard_index ascending order then bundle entry order. Outcomes are true or unknown only. true requires a non-negated Item 1 / Part I omission construction tied structurally to General Instruction J and at least one block-opening Regulation AB item heading; every true record carries the exact minimal raw-byte span of each matched construction; the offsets are authoritative and the stored quote is the deterministic tag/entity/whitespace-normalized rendering of that span, not necessarily raw-byte-equal where entities occur. This manifest and the shell-company determination manifests are distinct contracts and mutually reject.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "determination_contract",
    "aggregate_manifest_path",
    "aggregate_manifest_sha256",
    "aggregate_run_id",
    "queue_id",
    "queue_definition_sha256",
    "execution_run_ids",
    "shards_consumed",
    "determination_record_order",
    "rule",
    "carrier_provenance",
    "counts",
    "reconciliation",
    "output_hashes",
    "run_timestamp",
    "schema_versions",
    "limitations"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "determination_contract": {
      "const": "asset_backed_issuer_determination@0.1.0"
    },
    "aggregate_manifest_path": {
      "type": "string"
    },
    "aggregate_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "aggregate_run_id": {
      "type": "string"
    },
    "queue_id": {
      "type": "string"
    },
    "queue_definition_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_run_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shards_consumed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shard_index",
          "run_dir",
          "bundle_manifest_sha256",
          "acquisition_manifest_sha256",
          "rows"
        ],
        "properties": {
          "shard_index": {
            "type": "integer",
            "minimum": 0
          },
          "run_dir": {
            "type": "string"
          },
          "bundle_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "acquisition_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rows": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "determination_record_order": {
      "const": "shard_index_then_bundle_entry_order"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "reason_code",
        "reg_ab_item_numbers",
        "negation_window_bytes",
        "item_tie_window_bytes"
      ],
      "properties": {
        "rule_id": {
          "const": "instruction_j_omission_and_reg_ab_items@1"
        },
        "reason_code": {
          "const": "ASSET_BACKED_ISSUER"
        },
        "reg_ab_item_numbers": {
          "const": [
            "1112",
            "1114",
            "1115",
            "1117",
            "1119",
            "1122",
            "1123"
          ]
        },
        "negation_window_bytes": {
          "const": 40
        },
        "item_tie_window_bytes": {
          "const": 150
        }
      }
    },
    "carrier_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier_run_id",
        "carrier_manifest_sha256",
        "freeze_record_sha256"
      ],
      "properties": {
        "carrier_run_id": {
          "type": "string"
        },
        "carrier_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "freeze_record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows_considered",
        "determinations",
        "asset_backed_true",
        "asset_backed_unknown",
        "by_basis",
        "shards_consumed"
      ],
      "properties": {
        "rows_considered": {
          "type": "integer",
          "minimum": 1
        },
        "determinations": {
          "type": "integer",
          "minimum": 1
        },
        "asset_backed_true": {
          "type": "integer",
          "minimum": 0
        },
        "asset_backed_unknown": {
          "type": "integer",
          "minimum": 0
        },
        "by_basis": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "shards_consumed": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "output_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_backed_issuer_determinations.jsonl"
      ],
      "properties": {
        "asset_backed_issuer_determinations.jsonl": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "run_timestamp": {
      "type": "string"
    },
    "schema_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_backed_issuer_determination",
        "asset_backed_issuer_determination_manifest",
        "acquisition_queue_aggregate_manifest_v2"
      ],
      "properties": {
        "asset_backed_issuer_determination": {
          "type": "string"
        },
        "asset_backed_issuer_determination_manifest": {
          "type": "string"
        },
        "acquisition_queue_aggregate_manifest_v2": {
          "type": "string"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
