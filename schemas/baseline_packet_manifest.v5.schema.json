{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "baseline_packet_manifest.v5.schema.json",
  "title": "Baseline packet run manifest (v0.5, lineage cohort, shell- and asset-backed-filtered, locator-declared)",
  "description": "Immutable record of one full-cohort Item 1 packet build over a completed acquisition lineage, screened by two determinations (ADR-103/104/107). A carrier row is excluded iff its ADR-102 shell determination or its ADR-105 asset-backed-issuer determination is the literal true; false and unknown rows are always retained, and packetization establishes nothing beyond a locatable Item 1 - in particular it does not establish software eligibility. Each determination binds relationally to the supplied aggregate (recomputed aggregate hash, aggregate run id, queue identity, carrier provenance, exact per-shard tuple mapping) and is validated against its own record and manifest contracts with its JSONL re-hashed against its manifest's output_hashes entry; both JSONLs are proven to hold exactly one record per aggregate carrier row before any output directory exists. Packet records keep the unchanged universe_baseline_packet@0.2.0 contract with all five issuer flags null: the determinations live here at run level, never in evidence-less packet flags. Exclusion accounting is recorded as shell_true, asset_backed_true, both_true, shell_only_true, asset_backed_only_true and firms_excluded (the union), cohort-wide and per shard, with reconciliation identities proving the partitions. Records are written in shard_index ascending order then bundle entry order after union-exclusion omission. The 0.1.0 through 0.4.0 schemas are retained byte-identical and remain the only validators for artifacts written under them; v0.4 and v0.5 mutually reject.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "aggregate_manifest_path",
    "aggregate_manifest_sha256",
    "aggregate_run_id",
    "queue_id",
    "queue_definition_sha256",
    "execution_run_ids",
    "shell_determination_manifest_path",
    "shell_determination_manifest_sha256",
    "shell_determination_run_id",
    "shell_determinations_jsonl_sha256",
    "asset_backed_determination_manifest_path",
    "asset_backed_determination_manifest_sha256",
    "asset_backed_determination_run_id",
    "asset_backed_determinations_jsonl_sha256",
    "shards_consumed",
    "packet_record_order",
    "item_one_locator",
    "bundle_contract",
    "carrier_provenance",
    "route_validation",
    "baseline_cutoff",
    "baseline_cutoff_source",
    "counts",
    "reconciliation",
    "output_hashes",
    "run_timestamp",
    "schema_versions",
    "limitations"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "aggregate_manifest_path": {
      "type": "string"
    },
    "aggregate_manifest_sha256": {
      "description": "Recomputed over the supplied aggregate's bytes at run time; required to equal the determination manifest's recorded aggregate_manifest_sha256. A relational binding between the two supplied inputs, never a pinned literal.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "aggregate_run_id": {
      "type": "string"
    },
    "queue_id": {
      "type": "string"
    },
    "queue_definition_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_run_ids": {
      "description": "Copied verbatim from the aggregate. Provenance only: it orders nothing here, and permuting it cannot move a packet record.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shell_determination_manifest_path": {
      "type": "string"
    },
    "shell_determination_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "shell_determination_run_id": {
      "type": "string"
    },
    "shell_determinations_jsonl_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "asset_backed_determination_manifest_path": {
      "type": "string"
    },
    "asset_backed_determination_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "asset_backed_determination_run_id": {
      "type": "string"
    },
    "asset_backed_determinations_jsonl_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "shards_consumed": {
      "description": "Every shard whose bundle was read, ordered by shard_index, tuple-equal with both determinations' consumed shards, each carrying the same five-way exclusion accounting as the cohort counts (shell_true, asset_backed_true, both_true, shell_only_true, asset_backed_only_true) plus rows_excluded, rows_retained, packets_built and packet_failures. The arithmetic identities across these fields are not expressible in JSON Schema and are enforced by the runner's reconciliation, which refuses before writing.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shard_index",
          "run_dir",
          "bundle_manifest_sha256",
          "acquisition_manifest_sha256",
          "rows",
          "shell_true",
          "asset_backed_true",
          "both_true",
          "shell_only_true",
          "asset_backed_only_true",
          "rows_excluded",
          "rows_retained",
          "packets_built",
          "packet_failures"
        ],
        "properties": {
          "shard_index": {
            "type": "integer",
            "minimum": 0
          },
          "run_dir": {
            "type": "string"
          },
          "bundle_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "acquisition_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rows": {
            "type": "integer",
            "minimum": 1
          },
          "shell_true": {
            "type": "integer",
            "minimum": 0
          },
          "asset_backed_true": {
            "type": "integer",
            "minimum": 0
          },
          "both_true": {
            "type": "integer",
            "minimum": 0
          },
          "shell_only_true": {
            "type": "integer",
            "minimum": 0
          },
          "asset_backed_only_true": {
            "type": "integer",
            "minimum": 0
          },
          "rows_excluded": {
            "type": "integer",
            "minimum": 0
          },
          "rows_retained": {
            "type": "integer",
            "minimum": 0
          },
          "packets_built": {
            "type": "integer",
            "minimum": 0
          },
          "packet_failures": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "packet_record_order": {
      "const": "shard_index_then_bundle_entry_order_after_union_exclusion"
    },
    "item_one_locator": {
      "description": "The canonical key of the closed HTML-locator mapping entry this run resolved and used. Derived from the mapping, never copied from operator text.",
      "enum": [
        "item_one_span_v2",
        "item_one_span_v3"
      ]
    },
    "bundle_contract": {
      "description": "Every consumed shard declared this one bundle contract; a lineage mixes no generations.",
      "const": "baseline_primary_document_bundle@0.2.0"
    },
    "carrier_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier_run_id",
        "carrier_manifest_sha256",
        "freeze_record_sha256"
      ],
      "properties": {
        "carrier_run_id": {
          "type": "string"
        },
        "carrier_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "freeze_record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "route_validation": {
      "description": "One value for the whole cohort: every consumed bundle declared this same route validation, and disagreement was refused.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_run_id",
        "probe_manifest_sha256",
        "covered_accessions",
        "note"
      ],
      "properties": {
        "probe_run_id": {
          "type": "string"
        },
        "probe_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "covered_accessions": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "baseline_cutoff": {
      "type": "string",
      "format": "date"
    },
    "baseline_cutoff_source": {
      "type": "object"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned_rows",
        "shell_true",
        "shell_false",
        "shell_unknown",
        "asset_backed_true",
        "asset_backed_unknown",
        "both_true",
        "shell_only_true",
        "asset_backed_only_true",
        "firms_excluded",
        "retained_rows",
        "packets_built",
        "packet_failures",
        "shards_consumed",
        "packets_by_end_boundary",
        "failures_by_reason",
        "passages_total",
        "packet_bytes_total",
        "packet_bytes_max",
        "packet_bytes_mean"
      ],
      "properties": {
        "planned_rows": {
          "type": "integer",
          "minimum": 1
        },
        "shell_true": {
          "type": "integer",
          "minimum": 0
        },
        "shell_false": {
          "type": "integer",
          "minimum": 0
        },
        "shell_unknown": {
          "type": "integer",
          "minimum": 0
        },
        "firms_excluded": {
          "description": "The union of the shell-true and asset-backed-true row sets: shell_true + asset_backed_true - both_true, exactly.",
          "type": "integer",
          "minimum": 0
        },
        "retained_rows": {
          "type": "integer",
          "minimum": 0
        },
        "packets_built": {
          "type": "integer",
          "minimum": 0
        },
        "packet_failures": {
          "type": "integer",
          "minimum": 0
        },
        "shards_consumed": {
          "type": "integer",
          "minimum": 1
        },
        "packets_by_end_boundary": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "failures_by_reason": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "passages_total": {
          "type": "integer",
          "minimum": 0
        },
        "packet_bytes_total": {
          "type": "integer",
          "minimum": 0
        },
        "packet_bytes_max": {
          "type": "integer",
          "minimum": 0
        },
        "packet_bytes_mean": {
          "type": "integer",
          "minimum": 0
        },
        "asset_backed_true": {
          "type": "integer",
          "minimum": 0
        },
        "asset_backed_unknown": {
          "type": "integer",
          "minimum": 0
        },
        "both_true": {
          "type": "integer",
          "minimum": 0
        },
        "shell_only_true": {
          "type": "integer",
          "minimum": 0
        },
        "asset_backed_only_true": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "output_hashes": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "run_timestamp": {
      "type": "string"
    },
    "schema_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universe_baseline_packet_v2",
        "baseline_packet_manifest_v5",
        "shell_company_determination_manifest_v3",
        "asset_backed_issuer_determination_manifest",
        "acquisition_queue_aggregate_manifest_v2"
      ],
      "properties": {
        "universe_baseline_packet_v2": {
          "type": "string"
        },
        "baseline_packet_manifest_v5": {
          "type": "string"
        },
        "shell_company_determination_manifest_v3": {
          "type": "string"
        },
        "asset_backed_issuer_determination_manifest": {
          "type": "string"
        },
        "acquisition_queue_aggregate_manifest_v2": {
          "type": "string"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
