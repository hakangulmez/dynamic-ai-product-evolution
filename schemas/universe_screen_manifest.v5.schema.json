{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "universe_screen_manifest.v5.schema.json",
  "title": "Universe high-recall screen run manifest (v0.5, short citation references)",
  "description": "Immutable manifest for a live governed screen that rendered the v4 prompt. The model sees only deterministic short passage references (P001 etc.); the runner resolves each known reference to the packet's immutable passage hash before applying the unchanged strict quote validator and persisting accepted evidence. Raw responses retain the model-facing reference; records retain the resolved immutable passage id. This is an addressing successor, not a relaxation of evidence or governance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "packet_manifest_path", "packet_manifest_sha256", "packet_run_id",
    "packets_jsonl_sha256", "packet_failures_jsonl_sha256", "prompt_template_path",
    "prompt_template_sha256", "authorization_id", "authorization_sha256",
    "screen_adapter_enablement_sha256", "provider_client_contract_reference",
    "provider_client_contract_sha256", "envelope_text_extraction_rule", "selection",
    "provider", "screen_record_order", "firm_rollup_rule", "baseline_cutoff", "counts",
    "request_accounting", "reconciliation", "output_hashes", "run_timestamp",
    "schema_versions", "limitations"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "packet_manifest_path": {"type": "string", "minLength": 1},
    "packet_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "packet_run_id": {"type": "string", "minLength": 1},
    "packets_jsonl_sha256": {"$ref": "#/$defs/sha256"},
    "packet_failures_jsonl_sha256": {"$ref": "#/$defs/sha256"},
    "prompt_template_path": {"const": "prompts/discovery/universe_high_recall_screen.v4.md"},
    "prompt_template_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_id": {"type": "string", "minLength": 1},
    "authorization_sha256": {"$ref": "#/$defs/sha256"},
    "screen_adapter_enablement_sha256": {"$ref": "#/$defs/sha256"},
    "provider_client_contract_reference": {"type": "string", "minLength": 1},
    "provider_client_contract_sha256": {"$ref": "#/$defs/sha256"},
    "envelope_text_extraction_rule": {"const": "vertex_generate_content_candidates0_text_parts@1"},
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["selection_artifact_path", "selection_artifact_sha256", "selection_kind", "sampling_algorithm", "seed", "rows_selected"],
      "properties": {
        "selection_artifact_path": {"type": "string", "minLength": 1},
        "selection_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "selection_kind": {"enum": ["canary_100", "full_cohort"]},
        "sampling_algorithm": {"type": "string", "minLength": 1},
        "seed": {"type": ["integer", "null"]},
        "rows_selected": {"type": "integer", "minimum": 1}
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "model_route"],
      "properties": {
        "name": {"const": "vertex_gemini_v2"},
        "model_route": {"type": "object"}
      }
    },
    "screen_record_order": {"type": "string", "minLength": 1},
    "firm_rollup_rule": {"type": "string", "minLength": 1},
    "baseline_cutoff": {"type": "string", "format": "date"},
    "counts": {"type": "object"},
    "request_accounting": {"type": "object"},
    "reconciliation": {"type": "object"},
    "output_hashes": {
      "type": "object", "additionalProperties": false,
      "required": ["universe_screen_records.jsonl", "universe_screen_raw_responses.jsonl", "universe_screen_capture_ledger.jsonl"],
      "properties": {
        "universe_screen_records.jsonl": {"$ref": "#/$defs/sha256"},
        "universe_screen_raw_responses.jsonl": {"$ref": "#/$defs/sha256"},
        "universe_screen_capture_ledger.jsonl": {"$ref": "#/$defs/sha256"}
      }
    },
    "run_timestamp": {"type": "string", "minLength": 1},
    "schema_versions": {
      "type": "object", "additionalProperties": false,
      "required": ["universe_screen_record", "universe_screen_manifest_v5", "universe_screen_selection", "universe_screen_live_authorization", "universe_screen_adapter_enablement", "baseline_packet_manifest_v5", "universe_baseline_packet_v2"],
      "properties": {
        "universe_screen_record": {"const": "0.1.0"},
        "universe_screen_manifest_v5": {"const": "0.5.0"},
        "universe_screen_selection": {"const": "0.1.0"},
        "universe_screen_live_authorization": {"const": "0.1.0"},
        "universe_screen_adapter_enablement": {"const": "0.1.0"},
        "baseline_packet_manifest_v5": {"const": "0.5.0"},
        "universe_baseline_packet_v2": {"const": "0.2.0"}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
