{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pct_item1_combined_snapshot_output.v4.schema.json",
  "title": "PCT Item 1 combined snapshot model output v4",
  "description": "Development-only model-facing output for one Item 1 product-family-product-capability-task-family snapshot. Product families are explicit commercial groupings, products remain independently identifiable customer offerings, and task families represent durable customer outcomes rather than interface steps.",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_families", "products", "capabilities", "task_families"],
  "properties": {
    "product_families": {"type": "array", "items": {"$ref": "#/$defs/product_family"}},
    "products": {"type": "array", "items": {"$ref": "#/$defs/product"}},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "task_families": {"type": "array", "items": {"$ref": "#/$defs/task_family"}}
  },
  "$defs": {
    "availability_status": {
      "type": "string",
      "enum": [
        "announced", "private_beta", "public_beta", "general_availability",
        "broadly_deployed_or_default", "deprecated", "discontinued", "unknown"
      ]
    },
    "passage_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^P[0-9]{3}$"}
    },
    "product_family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "passage_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^F[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "passage_refs": {"$ref": "#/$defs/passage_refs"}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "product_family_id", "availability_status", "passage_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^P[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "product_family_id": {"type": ["string", "null"], "pattern": "^F[1-9][0-9]*$"},
        "availability_status": {"$ref": "#/$defs/availability_status"},
        "passage_refs": {"$ref": "#/$defs/passage_refs"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "product_id", "text", "passage_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^C[1-9][0-9]*$"},
        "product_id": {"type": "string", "pattern": "^P[1-9][0-9]*$"},
        "text": {"type": "string", "minLength": 1},
        "passage_refs": {"$ref": "#/$defs/passage_refs"}
      }
    },
    "task_family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "product_id", "capability_ids", "text", "customer_outcome", "passage_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^TF[1-9][0-9]*$"},
        "product_id": {"type": "string", "pattern": "^P[1-9][0-9]*$"},
        "capability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^C[1-9][0-9]*$"}
        },
        "text": {"type": "string", "minLength": 1},
        "customer_outcome": {"type": "string", "minLength": 1},
        "passage_refs": {"$ref": "#/$defs/passage_refs"}
      }
    }
  }
}
