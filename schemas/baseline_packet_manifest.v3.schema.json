{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "baseline_packet_manifest.v3.schema.json",
  "title": "Baseline packet run manifest (v0.3, lineage cohort, shell-filtered)",
  "description": "Immutable record of one full-cohort Item 1 packet build over a completed acquisition lineage (ADR-103). The v0.2 predecessor describes a single-bundle run: its bundle_manifest_sha256 names one bundle and its counts pin firms_excluded to zero, so a cohort spread over many bundles with deterministic shell exclusions cannot validate under it. This successor binds the ADR-101 aggregate (by path, recomputed hash, run id and queue identity) and the ADR-102 shell determination (by manifest path, recomputed hash, run id and its determinations JSONL hash), and requires their exact agreement: the determination's recorded aggregate hash must equal the recomputed aggregate bytes, and the per-shard tuple mapping (shard_index, run_dir, bundle_manifest_sha256, acquisition_manifest_sha256, rows) must be identical between the two, index by index. The aggregate remains the sole authority for which shard directories were opened. Rows whose determination is shell_company true are excluded; false and unknown are retained and packetized under the unchanged universe_baseline_packet@0.2.0 record contract, whose issuer_status_flags stay null because the packet itself still has no cover-page route - the shell result is bound here at run level, never written into record fields it did not evidence. A retained document without a usable Item 1 is a per-row failure record, never an exclusion and never a silent drop. Packet records are written in shard_index ascending order, then in each bundle manifest's own entry order, after shell-true omission; the order is independent of how the execution runs were enumerated. The 0.1.0 and 0.2.0 schemas are retained unchanged and remain the only validators for artefacts written under those shapes; this file never validates one of them, and neither validates a 0.3.0 manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "aggregate_manifest_path",
    "aggregate_manifest_sha256",
    "aggregate_run_id",
    "queue_id",
    "queue_definition_sha256",
    "execution_run_ids",
    "determination_manifest_path",
    "determination_manifest_sha256",
    "determination_run_id",
    "determinations_jsonl_sha256",
    "shards_consumed",
    "packet_record_order",
    "bundle_contract",
    "carrier_provenance",
    "route_validation",
    "baseline_cutoff",
    "baseline_cutoff_source",
    "counts",
    "reconciliation",
    "output_hashes",
    "run_timestamp",
    "schema_versions",
    "limitations"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "aggregate_manifest_path": {
      "type": "string"
    },
    "aggregate_manifest_sha256": {
      "description": "Recomputed over the supplied aggregate's bytes at run time; required to equal the determination manifest's recorded aggregate_manifest_sha256. A relational binding between the two supplied inputs, never a pinned literal.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "aggregate_run_id": {
      "type": "string"
    },
    "queue_id": {
      "type": "string"
    },
    "queue_definition_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_run_ids": {
      "description": "Copied verbatim from the aggregate. Provenance only: it orders nothing here, and permuting it cannot move a packet record.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "determination_manifest_path": {
      "type": "string"
    },
    "determination_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "determination_run_id": {
      "type": "string"
    },
    "determinations_jsonl_sha256": {
      "description": "Recomputed over the determination JSONL bytes at run time; required to equal that manifest's own output_hashes entry.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "shards_consumed": {
      "description": "Every shard whose bundle was read, ordered by shard_index. Exactly the aggregate's authoritative records, tuple-equal with the determination manifest's consumed shards.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shard_index",
          "run_dir",
          "bundle_manifest_sha256",
          "acquisition_manifest_sha256",
          "rows",
          "rows_excluded_shell",
          "rows_retained",
          "packets_built",
          "packet_failures"
        ],
        "properties": {
          "shard_index": {
            "type": "integer",
            "minimum": 0
          },
          "run_dir": {
            "type": "string"
          },
          "bundle_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "acquisition_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rows": {
            "type": "integer",
            "minimum": 1
          },
          "rows_excluded_shell": {
            "type": "integer",
            "minimum": 0
          },
          "rows_retained": {
            "type": "integer",
            "minimum": 0
          },
          "packets_built": {
            "type": "integer",
            "minimum": 0
          },
          "packet_failures": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "packet_record_order": {
      "const": "shard_index_then_bundle_entry_order_after_shell_exclusion"
    },
    "bundle_contract": {
      "description": "Every consumed shard declared this one bundle contract; a lineage mixes no generations.",
      "const": "baseline_primary_document_bundle@0.2.0"
    },
    "carrier_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier_run_id",
        "carrier_manifest_sha256",
        "freeze_record_sha256"
      ],
      "properties": {
        "carrier_run_id": {
          "type": "string"
        },
        "carrier_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "freeze_record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "route_validation": {
      "description": "One value for the whole cohort: every consumed bundle declared this same route validation, and disagreement was refused.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_run_id",
        "probe_manifest_sha256",
        "covered_accessions",
        "note"
      ],
      "properties": {
        "probe_run_id": {
          "type": "string"
        },
        "probe_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "covered_accessions": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "baseline_cutoff": {
      "type": "string",
      "format": "date"
    },
    "baseline_cutoff_source": {
      "type": "object"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned_rows",
        "shell_true",
        "shell_false",
        "shell_unknown",
        "firms_excluded",
        "retained_rows",
        "packets_built",
        "packet_failures",
        "shards_consumed",
        "packets_by_end_boundary",
        "failures_by_reason",
        "passages_total",
        "packet_bytes_total",
        "packet_bytes_max",
        "packet_bytes_mean"
      ],
      "properties": {
        "planned_rows": {
          "type": "integer",
          "minimum": 1
        },
        "shell_true": {
          "type": "integer",
          "minimum": 0
        },
        "shell_false": {
          "type": "integer",
          "minimum": 0
        },
        "shell_unknown": {
          "type": "integer",
          "minimum": 0
        },
        "firms_excluded": {
          "description": "Equals shell_true exactly: the one deterministic exclusion this stage applies. The v0.2 predecessor pins this to zero, which is precisely why it cannot describe this run.",
          "type": "integer",
          "minimum": 0
        },
        "retained_rows": {
          "type": "integer",
          "minimum": 0
        },
        "packets_built": {
          "type": "integer",
          "minimum": 0
        },
        "packet_failures": {
          "type": "integer",
          "minimum": 0
        },
        "shards_consumed": {
          "type": "integer",
          "minimum": 1
        },
        "packets_by_end_boundary": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "failures_by_reason": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "passages_total": {
          "type": "integer",
          "minimum": 0
        },
        "packet_bytes_total": {
          "type": "integer",
          "minimum": 0
        },
        "packet_bytes_max": {
          "type": "integer",
          "minimum": 0
        },
        "packet_bytes_mean": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "output_hashes": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "run_timestamp": {
      "type": "string"
    },
    "schema_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universe_baseline_packet_v2",
        "baseline_packet_manifest_v3",
        "shell_company_determination_manifest_v3",
        "acquisition_queue_aggregate_manifest_v2"
      ],
      "properties": {
        "universe_baseline_packet_v2": {
          "type": "string"
        },
        "baseline_packet_manifest_v3": {
          "type": "string"
        },
        "shell_company_determination_manifest_v3": {
          "type": "string"
        },
        "acquisition_queue_aggregate_manifest_v2": {
          "type": "string"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
