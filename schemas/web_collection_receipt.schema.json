{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "web_collection_receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "spec_version",
    "code_commit",
    "run_created_at",
    "company_id",
    "request_plan_sha256",
    "collection_client_contract_hash",
    "initial_requests",
    "robots_requests",
    "prompt_hash",
    "model_route"
  ],
  "$defs": {
    "request_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_url", "final_url", "http_status", "retrieval_timestamp"],
      "properties": {
        "candidate_id": { "type": ["string", "null"] },
        "requested_url": { "type": "string" },
        "final_url": { "type": "string" },
        "redirect_hops": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "status_code"],
            "properties": {
              "url": { "type": "string" },
              "status_code": { "type": "integer" }
            }
          }
        },
        "http_status": { "type": "integer" },
        "retry_count": { "type": "integer", "minimum": 0 },
        "byte_count": { "type": ["integer", "null"], "minimum": 0 },
        "content_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "retrieval_timestamp": { "type": "string" },
        "robots_decision": { "type": ["string", "null"] },
        "archive_host": { "type": ["string", "null"] },
        "archive_url": { "type": ["string", "null"] },
        "snapshot_timestamp": { "type": ["string", "null"] }
      }
    }
  },
  "properties": {
    "contract": { "const": "web_collection_receipt@0.1.0" },
    "schema_version": { "type": "string" },
    "spec_version": { "const": "SPEC-005" },
    "code_commit": { "type": "string", "minLength": 1 },
    "run_created_at": { "type": "string", "minLength": 1 },
    "company_id": { "type": "string", "pattern": "^CIK[0-9]{10}$" },
    "request_plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "collection_client": { "type": "object" },
    "collection_client_contract_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "initial_requests": {
      "type": "array",
      "items": { "$ref": "#/$defs/request_record" }
    },
    "robots_requests": {
      "type": "array",
      "items": { "$ref": "#/$defs/request_record" }
    },
    "retry_count": { "type": "integer", "minimum": 0 },
    "prompt_hash": { "type": "null" },
    "model_route": { "type": "null" }
  }
}
