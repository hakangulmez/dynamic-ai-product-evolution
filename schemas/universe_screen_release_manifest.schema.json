{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamic-ai-products/schemas/universe_screen_release_manifest.schema.json",
  "title": "Universe screen release manifest v0.1.0",
  "description": "ADR-124. The first immutable SCREEN release, reconciled deterministically from two completed, hash-bound runs with no model call. No authorization governs it: a reconciliation spends nothing, so its correctness is fully determined by the pinned source digests and one supersession rule. The residual tolerance is a const rather than a range, so a future release with a different residual needs a new contract and a new decision rather than inheriting this one's.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_contract",
    "release_id",
    "release_kind",
    "run_timestamp",
    "sources",
    "supersession_rule",
    "output_contract",
    "output_hashes",
    "record_order",
    "counts",
    "rates",
    "reconciliation",
    "schema_versions",
    "limitations"
  ],
  "properties": {
    "manifest_contract": {
      "const": "universe_screen_release_manifest@0.1.0"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "release_kind": {
      "const": "screen_release_v1"
    },
    "run_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "repair",
        "sources_unmodified",
        "no_model_call"
      ],
      "properties": {
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "manifest_path",
            "manifest_sha256",
            "records_jsonl_sha256",
            "raw_responses_jsonl_sha256"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "manifest_path": {
              "type": "string",
              "minLength": 1
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "records_jsonl_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "raw_responses_jsonl_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "repair": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "manifest_path",
            "manifest_sha256",
            "records_jsonl_sha256",
            "raw_responses_jsonl_sha256",
            "selection_artifact_sha256"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "manifest_path": {
              "type": "string",
              "minLength": 1
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "records_jsonl_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "raw_responses_jsonl_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "selection_artifact_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "sources_unmodified": {
          "const": true
        },
        "no_model_call": {
          "description": "A reconciliation is a derivation. No provider, endpoint, prompt or token is involved.",
          "const": true
        }
      }
    },
    "supersession_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "replaces_only_record_kind",
        "requires_repair_record_kind",
        "coverage_is_exact"
      ],
      "properties": {
        "rule": {
          "const": "repair_screened_supersedes_base_unverified@1"
        },
        "replaces_only_record_kind": {
          "const": "model_evidence_unverified"
        },
        "requires_repair_record_kind": {
          "const": "screened_packet"
        },
        "coverage_is_exact": {
          "const": true
        }
      }
    },
    "output_contract": {
      "const": "universe_screen_release_record@0.1.0"
    },
    "output_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universe_screen_release_records.jsonl"
      ],
      "properties": {
        "universe_screen_release_records.jsonl": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "record_order": {
      "const": "base_planned_row_order"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned_rows",
        "cohort_rows",
        "base_valid",
        "repaired",
        "unresolved_after_repair",
        "insufficient_evidence",
        "model_output_truncated",
        "valid_screened_rows",
        "max_unresolved_after_repair",
        "by_screen_status",
        "unresolved_by_base_reason",
        "unresolved_by_repair_reason",
        "repaired_by_base_reason"
      ],
      "properties": {
        "planned_rows": {
          "type": "integer",
          "minimum": 1
        },
        "cohort_rows": {
          "type": "integer",
          "minimum": 1
        },
        "base_valid": {
          "type": "integer",
          "minimum": 0
        },
        "repaired": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_after_repair": {
          "type": "integer",
          "minimum": 0
        },
        "insufficient_evidence": {
          "type": "integer",
          "minimum": 0
        },
        "model_output_truncated": {
          "type": "integer",
          "minimum": 0
        },
        "valid_screened_rows": {
          "type": "integer",
          "minimum": 0
        },
        "max_unresolved_after_repair": {
          "description": "The residual this release accepts, pinned exactly. Not inherited from any run-time breaker.",
          "const": 211
        },
        "by_screen_status": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "unresolved_by_base_reason": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "unresolved_by_repair_reason": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "repaired_by_base_reason": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "rates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_repair_unverified_rate",
        "residual_unverified_rate",
        "rate_denominator"
      ],
      "properties": {
        "pre_repair_unverified_rate": {
          "type": "number",
          "minimum": 0
        },
        "residual_unverified_rate": {
          "type": "number",
          "minimum": 0
        },
        "rate_denominator": {
          "const": "cohort_rows"
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "minProperties": 18,
      "additionalProperties": {
        "const": true
      }
    },
    "schema_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
