{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "web_snapshot_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "company_id",
    "candidate_id",
    "content_family",
    "access_channel",
    "source_url",
    "requested_url",
    "final_url",
    "http_status",
    "content_sha256",
    "retrieval_timestamp",
    "historical_validity",
    "raw_path",
    "recollected"
  ],
  "properties": {
    "contract": { "const": "web_snapshot_manifest@0.1.0" },
    "schema_version": { "type": "string" },
    "company_id": { "type": "string", "pattern": "^CIK[0-9]{10}$" },
    "candidate_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "content_family": {
      "enum": ["official_ir", "product_pages", "developer_docs", "newsroom"]
    },
    "access_channel": { "enum": ["live", "archive"] },
    "source_url": { "type": "string" },
    "archive_url": { "type": ["string", "null"] },
    "archive_host": { "type": ["string", "null"] },
    "requested_url": { "type": "string" },
    "final_url": { "type": "string" },
    "redirect_hops": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "status_code"],
        "properties": {
          "url": { "type": "string" },
          "status_code": { "type": "integer" }
        }
      },
      "maxItems": 5
    },
    "http_status": { "type": "integer" },
    "retry_count": { "type": "integer", "minimum": 0 },
    "byte_count": { "type": "integer", "minimum": 0 },
    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "retrieval_timestamp": { "type": "string" },
    "publication_date": { "type": ["string", "null"], "format": "date" },
    "snapshot_timestamp": { "type": ["string", "null"] },
    "historical_validity": { "enum": ["valid", "invalid", "uncertain"] },
    "raw_path": { "type": "string" },
    "recollected": { "const": false }
  }
}
