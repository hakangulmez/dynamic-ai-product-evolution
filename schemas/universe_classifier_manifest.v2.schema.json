{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamic-ai-products/schemas/universe_classifier_manifest.v2.schema.json",
  "title": "Universe classifier manifest v0.2.0",
  "description": "ADR-128. Successor bound to the V2.2 prompt and the 0.2.0 axes and record contracts. The tier rules and the economic axes vocabulary are unchanged; taxonomy_version moves to universe_classifier_axes_v2_2 to denote the axes-CONTRACT identity, not any change in economic taxonomy. ADR-126. The authoritative output of one live classifier run. It binds every input by digest \u2014 cohort, overlay, SCREEN_v1, packet chain, prompt and tier-rule config \u2014 and states the tier distribution beside the axes that produced it. It is non-promotable: a classifier run is an observation, and promotion to a frozen universe is a separate decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_id",
    "authorization_sha256",
    "bounded_outcomes",
    "counts",
    "endpoint_allowlist",
    "envelope_text_extraction_rule",
    "limitations",
    "manifest_contract",
    "output_contract",
    "output_hashes",
    "promotable",
    "prompt_template_path",
    "prompt_template_sha256",
    "provider",
    "provider_client_contract_reference",
    "provider_client_contract_sha256",
    "reconciliation",
    "record_order",
    "request_accounting",
    "run_id",
    "run_kind",
    "run_timestamp",
    "schema_versions",
    "screen_adapter_enablement_sha256",
    "sources",
    "taxonomy_version",
    "tier_rules_sha256",
    "tier_rules_version"
  ],
  "properties": {
    "manifest_contract": {
      "const": "universe_classifier_manifest@0.2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_kind": {
      "const": "classifier_v2_1"
    },
    "run_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "promotable": {
      "const": false
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "authorization_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort",
        "overlay",
        "release",
        "packet",
        "sources_unmodified"
      ],
      "properties": {
        "cohort": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cohort_id",
            "manifest_sha256",
            "records_jsonl_sha256"
          ],
          "properties": {
            "cohort_id": {
              "type": "string",
              "minLength": 1
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "records_jsonl_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "overlay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "overlay_id",
            "manifest_sha256",
            "decisions_jsonl_sha256"
          ],
          "properties": {
            "overlay_id": {
              "type": "string",
              "minLength": 1
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "decisions_jsonl_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release_id",
            "manifest_sha256",
            "records_jsonl_sha256"
          ],
          "properties": {
            "release_id": {
              "type": "string",
              "minLength": 1
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "records_jsonl_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "description": "The frozen SCREEN_v1 release. Screen evidence is read from the release's own records, so the classifier depends on the release rather than on the mutable runs that produced it; the raw-response id and digest each cohort row names are still matched against its release row."
        },
        "packet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packet_manifest_path",
            "packet_manifest_sha256",
            "packets_jsonl_sha256"
          ],
          "properties": {
            "packet_manifest_path": {
              "type": "string",
              "minLength": 1
            },
            "packet_manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "packets_jsonl_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "sources_unmodified": {
          "const": true
        }
      }
    },
    "prompt_template_path": {
      "const": "prompts/discovery/universe_full_classification.v2_2.md"
    },
    "prompt_template_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tier_rules_version": {
      "type": "string",
      "minLength": 1
    },
    "tier_rules_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "taxonomy_version": {
      "description": "The axes-contract identity this run used. It denotes the contract version, not a change in the economic axes vocabulary, which is unchanged from V2.1.",
      "const": "universe_classifier_axes_v2_2"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_label"
      ],
      "properties": {
        "provider": {
          "const": "google_vertex_ai"
        },
        "model_label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provider_client_contract_reference": {
      "type": "string",
      "minLength": 1
    },
    "provider_client_contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "screen_adapter_enablement_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "endpoint_allowlist": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "envelope_text_extraction_rule": {
      "type": "string",
      "minLength": 1
    },
    "output_contract": {
      "const": "universe_classifier_record@0.2.0"
    },
    "output_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universe_classifier_v2_2_raw_responses.jsonl",
        "universe_classifier_v2_2_records.jsonl",
        "universe_screen_capture_ledger.jsonl"
      ],
      "properties": {
        "universe_classifier_v2_2_records.jsonl": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "universe_classifier_v2_2_raw_responses.jsonl": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "universe_screen_capture_ledger.jsonl": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "record_order": {
      "const": "cohort_row_order"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_rows",
        "classified",
        "model_output_unusable",
        "provider_unresolved",
        "model_output_truncated",
        "by_admission_origin",
        "by_tier",
        "by_software_centrality",
        "by_firm_structure",
        "by_commercial_materiality",
        "by_customer_market_orientation",
        "contradiction_rows",
        "boundary_flag_rows",
        "unusable_by_reason"
      ],
      "properties": {
        "cohort_rows": {
          "type": "integer",
          "minimum": 0
        },
        "classified": {
          "type": "integer",
          "minimum": 0
        },
        "model_output_unusable": {
          "type": "integer",
          "minimum": 0
        },
        "provider_unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "model_output_truncated": {
          "type": "integer",
          "minimum": 0
        },
        "contradiction_rows": {
          "type": "integer",
          "minimum": 0
        },
        "boundary_flag_rows": {
          "type": "integer",
          "minimum": 0
        },
        "by_admission_origin": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_tier": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_software_centrality": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_firm_structure": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_commercial_materiality": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_customer_market_orientation": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "unusable_by_reason": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "request_accounting": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {
        "type": "integer"
      }
    },
    "bounded_outcomes": {
      "description": "The tolerances this grant authorized and what the run actually spent against them.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_provider_unresolved",
        "max_model_output_truncated",
        "max_model_output_unusable",
        "tier_excludes_market_orientation"
      ],
      "properties": {
        "max_provider_unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "max_model_output_truncated": {
          "type": "integer",
          "minimum": 0
        },
        "max_model_output_unusable": {
          "type": "integer",
          "minimum": 0
        },
        "tier_excludes_market_orientation": {
          "const": true
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "minProperties": 20,
      "additionalProperties": {
        "const": true
      }
    },
    "schema_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
