{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edgar_index_acquisition_manifest.v2.schema.json",
  "title": "EDGAR full-index acquisition manifest (v0.2, live transport)",
  "description": "Successor of edgar_index_acquisition_manifest@0.1.0 for live SEC retrieval. v0.1 remains the fixture_replay contract, byte-identical; this version admits only the sec_live transport and embeds the full transport contract (user agent with contact, request spacing, retry ladder, timeout, redirect policy) verbatim beside its hash, so the policy a run executed under is reproducible from the manifest alone. Presence of this manifest is the sole mark of an authoritative acquisition; it does not authorize frame consumption, which is a separately reviewed increment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "request_plan_sha256",
    "transport_kind",
    "transport_contract",
    "transport_contract_hash",
    "files",
    "counts",
    "run_timestamp",
    "schema_versions",
    "limitations"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "request_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transport_kind": {
      "enum": [
        "sec_live"
      ]
    },
    "transport_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport_kind",
        "transport_version",
        "user_agent",
        "min_request_spacing_seconds",
        "request_timeout_seconds",
        "max_retries_per_url",
        "retry_backoff_seconds",
        "retry_statuses",
        "follows_redirects"
      ],
      "properties": {
        "transport_kind": {
          "enum": [
            "sec_live"
          ]
        },
        "transport_version": {
          "type": "string"
        },
        "user_agent": {
          "type": "string",
          "pattern": "@"
        },
        "min_request_spacing_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "request_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_retries_per_url": {
          "type": "integer",
          "minimum": 0
        },
        "retry_backoff_seconds": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "retry_statuses": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        },
        "follows_redirects": {
          "const": false
        }
      }
    },
    "transport_contract_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quarter",
          "url",
          "filename",
          "sha256",
          "byte_count",
          "status_code",
          "retrieved_at"
        ],
        "properties": {
          "quarter": {
            "type": "string",
            "pattern": "^\\d{4}-QTR[1-4]$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://www\\.sec\\.gov/Archives/edgar/full-index/\\d{4}/QTR[1-4]/master\\.idx$"
          },
          "filename": {
            "type": "string",
            "pattern": "^master-\\d{4}-QTR[1-4]\\.idx$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0
          },
          "status_code": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "run_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "schema_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
