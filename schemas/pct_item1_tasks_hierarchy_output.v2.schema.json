{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pct_item1_tasks_hierarchy_output.v2.schema.json",
  "title": "PCT Item 1 task family and task output v2",
  "description": "Development-only task-family-plus-task output over a saved economic-product and product-local capability candidate map.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_families", "tasks"],
  "properties": {"task_families": {"type": "array", "items": {"$ref": "#/$defs/task_family"}}, "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}},
  "$defs": {
    "passage_refs": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^P[0-9]{3}$"}},
    "task": {"type": "object", "additionalProperties": false, "required": ["id", "economic_product_id", "capability_refs", "text", "passage_refs"], "properties": {"id": {"type": "string", "pattern": "^T[1-9][0-9]*$"}, "economic_product_id": {"type": "string", "pattern": "^EP[1-9][0-9]*$"}, "capability_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EP[1-9][0-9]*:C[1-9][0-9]*$"}}, "text": {"type": "string", "minLength": 1}, "passage_refs": {"$ref": "#/$defs/passage_refs"}}},
    "task_family": {"type": "object", "additionalProperties": false, "required": ["id", "economic_product_id", "name", "task_ids", "passage_refs"], "properties": {"id": {"type": "string", "pattern": "^TF[1-9][0-9]*$"}, "economic_product_id": {"type": "string", "pattern": "^EP[1-9][0-9]*$"}, "name": {"type": "string", "minLength": 1}, "task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^T[1-9][0-9]*$"}}, "passage_refs": {"$ref": "#/$defs/passage_refs"}}}
  }
}
