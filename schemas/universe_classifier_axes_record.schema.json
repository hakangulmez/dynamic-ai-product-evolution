{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamic-ai-products/schemas/universe_classifier_axes_record.schema.json",
  "title": "Universe classifier axes record v0.1.0",
  "description": "ADR-126. Exactly what the model returns for one firm: economic axes and the evidence for them. There is deliberately no tier field of any name. A tier is derived afterwards by a versioned deterministic engine from these axes, so a prompt revision can never silently move tier membership, and a model that emits a tier is refused rather than obeyed. Every array and string is bounded, because the run is held to the committed max-output-token contract and compactness is a contract term, not a preference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "customer_value_archetypes",
    "software_centrality",
    "complementary_dependencies",
    "firm_structure",
    "commercial_materiality",
    "customer_facing_functional_product",
    "economically_eligible",
    "data_eligible",
    "customer_market_orientation",
    "boundary_flags",
    "contradictions",
    "evidence",
    "confidence"
  ],
  "properties": {
    "customer_value_archetypes": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "FUNCTIONAL_SOFTWARE",
          "ADAPTIVE_DIGITAL_SERVICE",
          "DATA_ANALYTICS_PRODUCT",
          "TRANSACTION_INFRASTRUCTURE",
          "MARKETPLACE_COORDINATION",
          "CONTENT_CATALOG",
          "ATTENTION_SOCIAL_PLATFORM",
          "INTERACTIVE_ENTERTAINMENT",
          "HARDWARE_SOFTWARE_SYSTEM",
          "HUMAN_MANAGED_SERVICE",
          "ECOMMERCE_RETAIL",
          "PHYSICAL_SERVICE_NETWORK",
          "OTHER"
        ]
      }
    },
    "software_centrality": {
      "enum": [
        "CORE",
        "CO_ESSENTIAL",
        "ENABLING",
        "PERIPHERAL",
        "UNKNOWN"
      ]
    },
    "complementary_dependencies": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "NONE_OR_STANDARD_COMPUTE",
          "CUSTOMER_DATA",
          "FIRM_PROPRIETARY_DATA",
          "LICENSED_DATA",
          "LICENSED_CONTENT",
          "NETWORK_OR_INSTALLED_BASE",
          "REGULATED_TRANSACTION_RAIL",
          "EXECUTION_PERMISSIONS",
          "HARDWARE_OR_DEVICE",
          "PHYSICAL_SUPPLY_NETWORK",
          "LIVE_HUMAN_LABOR",
          "SPECIALIZED_NON_LLM_ENGINE",
          "OTHER"
        ]
      }
    },
    "firm_structure": {
      "enum": [
        "PURE_PLAY",
        "SOFTWARE_DOMINANT",
        "MIXED_SEPARABLE",
        "MIXED_NONSEPARABLE",
        "SOFTWARE_PERIPHERAL",
        "UNKNOWN"
      ]
    },
    "commercial_materiality": {
      "enum": [
        "DOMINANT",
        "MATERIAL",
        "MINOR",
        "UNKNOWN"
      ]
    },
    "customer_facing_functional_product": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "economically_eligible": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "data_eligible": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "customer_market_orientation": {
      "description": "Descriptive metadata only. The deterministic tier engine takes this as no input at all.",
      "enum": [
        "B2B",
        "B2C",
        "MIXED",
        "UNKNOWN"
      ]
    },
    "boundary_flags": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "contradictions": {
      "description": "Where the complete Item 1 packet qualifies or contradicts the non-authoritative admission context.",
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "axis",
          "passage_ref",
          "quote",
          "supported_claim"
        ],
        "properties": {
          "axis": {
            "enum": [
              "customer_value",
              "centrality",
              "dependency",
              "structure",
              "materiality",
              "eligibility"
            ]
          },
          "passage_ref": {
            "type": "string",
            "pattern": "^P[0-9]{3}$"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "supported_claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    }
  }
}
