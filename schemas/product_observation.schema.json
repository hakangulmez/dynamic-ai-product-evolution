{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "product_observation.schema.json",
  "required": [
    "product_observation_id",
    "company_id",
    "observation_cutoff",
    "product_name",
    "availability_status",
    "evidence",
    "confidence"
  ],
  "properties": {
    "product_observation_id": {
      "type": "string"
    },
    "stable_product_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "company_id": {
      "type": "string"
    },
    "observation_cutoff": {
      "type": "string",
      "format": "date"
    },
    "product_family": {
      "type": [
        "string",
        "null"
      ]
    },
    "product_name": {
      "type": "string"
    },
    "normalized_name": {
      "type": "string"
    },
    "entity_type": {
      "enum": [
        "product",
        "product_family",
        "bundle",
        "plan",
        "candidate"
      ]
    },
    "target_customers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "availability_status": {
      "type": "string"
    },
    "commercialization": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "passage_id",
          "quote"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "passage_id": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        }
      }
    },
    "ambiguity": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "schema_version": {
      "type": "string"
    }
  }
}
