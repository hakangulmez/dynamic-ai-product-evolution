{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamic-ai-products/schemas/universe_screen_repair_selection.schema.json",
  "title": "Universe screen repair selection v0.1.0",
  "description": "ADR-123 Stage 1. The rows a repair run re-asks, derived relationally from one completed continuation-v5 run under a single closed rule. No CIK, accession or count is ever authored: the population is every model_evidence_unverified record, ascending by source row ordinal, with no status-based filtering of any kind. The consuming runner re-derives this from the source bytes at preflight and refuses any difference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selection_contract",
    "selection_id",
    "selection_kind",
    "derivation_rule",
    "source_run_id",
    "source_manifest_path",
    "source_manifest_sha256",
    "source_records_jsonl_sha256",
    "source_raw_responses_jsonl_sha256",
    "packet_manifest_path",
    "packet_manifest_sha256",
    "rows",
    "counts",
    "run_timestamp",
    "limitations"
  ],
  "properties": {
    "selection_contract": {
      "const": "universe_screen_repair_selection@0.1.0"
    },
    "selection_id": {
      "type": "string",
      "minLength": 1
    },
    "selection_kind": {
      "const": "unverified_repair"
    },
    "derivation_rule": {
      "const": "unverified_rows_ascending_ordinal@1"
    },
    "source_run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_records_jsonl_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_raw_responses_jsonl_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "packet_manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "packet_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selection_ordinal",
          "source_row_ordinal",
          "cik",
          "accession",
          "packet_sha256",
          "source_failure_reason_code",
          "source_raw_response_id",
          "source_raw_response_sha256"
        ],
        "properties": {
          "selection_ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "source_row_ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "cik": {
            "type": "string",
            "pattern": "^[0-9]{10}$"
          },
          "accession": {
            "type": "string",
            "minLength": 1
          },
          "packet_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_failure_reason_code": {
            "enum": [
              "quote_resolution_failure",
              "adapter_rejection",
              "invalid_model_json",
              "temporal_violation"
            ]
          },
          "source_raw_response_id": {
            "type": "string",
            "minLength": 1
          },
          "source_raw_response_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_rows",
        "source_cohort_rows",
        "source_planned_rows",
        "by_source_failure_reason"
      ],
      "properties": {
        "selected_rows": {
          "type": "integer",
          "minimum": 1
        },
        "source_cohort_rows": {
          "type": "integer",
          "minimum": 1
        },
        "source_planned_rows": {
          "type": "integer",
          "minimum": 1
        },
        "by_source_failure_reason": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "run_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
