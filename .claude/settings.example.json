{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)",
      "Read(../**)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git clean -fdx *)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)"
    ],
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(python -m pytest *)",
      "Bash(pytest *)"
    ]
  }
}
